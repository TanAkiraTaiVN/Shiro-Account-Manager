root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,axaml,json,csproj,props}]
indent_style = space
indent_size = 4

[*.{axaml,json,csproj,props,yml,yaml}]
indent_size = 2

[*.cs]
# IDE1006: Naming Styles
dotnet_diagnostic.IDE1006.severity = none

