<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        xmlns:nexus="clr-namespace:RBX_Alt_Manager.Nexus"
        x:Class="RBX_Alt_Manager.AvaloniaUI.Views.NexusWindow"
        x:CompileBindings="True"
        Icon="/Resources/shiro.ico"
        Title="Nexus In-Game Controller • Shiro"
        Width="920" Height="620"
        MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0E"
        Foreground="#F4F4F5"
        TransparencyLevelHint="Mica, AcrylicBlur">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">
        <!-- Header -->
        <Border Grid.Row="0" Background="#141419" BorderBrush="#22222A" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="#2563EB">
                        <lucide:Lucide Icon="SlidersHorizontal" Width="14" Height="14" StrokeBrush="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Nexus Account Controller" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Border Background="#1E1E28" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                        <TextBlock x:Name="TxtServerStatusBadge" Text="Server: Đang dừng" FontSize="11" Foreground="#94A3B8"/>
                    </Border>
                </StackPanel>

                <!-- Server Config Quick Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Port:" VerticalAlignment="Center" FontSize="12" Foreground="#A1A1AA"/>
                    <TextBox x:Name="TxtNexusPort" Text="8080" Width="65" Height="28"
                             Background="#1C1C24" Foreground="#FFFFFF" BorderBrush="#2E2E38" BorderThickness="1"
                             CornerRadius="4" Padding="6,4" FontSize="12"/>
                    <CheckBox x:Name="ChkAllowExternal" Content="External" FontSize="12" Foreground="#A1A1AA"
                              VerticalAlignment="Center"/>
                    <Button x:Name="BtnToggleServer" Content="Bật Server" Click="BtnToggleServer_Click"
                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold"
                            CornerRadius="5" Padding="12,5" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Account Grid -->
        <Border Grid.Row="1" Background="#121217" BorderBrush="#22222A" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,12">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Background="#181820" Padding="8,6" CornerRadius="4" Margin="0,0,0,4">
                    <Grid ColumnDefinitions="50,150,110,200,*,70,70">
                        <TextBlock Grid.Column="0" Text="Chọn" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Tài khoản" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Trạng thái" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Server JobId" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Tọa độ" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" Text="FPS" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="6" Text="Ping" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                    </Grid>
                </Border>
                <ListBox Grid.Row="1" x:Name="DgAccounts" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="nexus:ControlledAccount">
                            <Grid ColumnDefinitions="50,150,110,200,*,70,70" Margin="0,2">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Username}" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusColorBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding JobId}" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding Position}" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{Binding Fps}" Foreground="#22C55E" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="{Binding Ping}" Foreground="#FBBF24" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Script Command Console Area -->
        <Border Grid.Row="2" Background="#141419" BorderBrush="#22222A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="TxtScriptInput" Watermark="Nhập script Lua hoặc lệnh Nexus để thực thi (vd: print('Hello from Shiro'))..."
                         AcceptsReturn="True" Height="64" TextWrapping="Wrap"
                         Background="#1A1A22" Foreground="#FFFFFF" BorderBrush="#2A2A36" BorderThickness="1"
                         CornerRadius="6" Padding="10,6" FontSize="12" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="BtnExecuteSelected" Content="Chạy (Đã chọn)" Click="BtnExecuteSelected_Click"
                            Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold"
                            CornerRadius="5" Padding="14,6" Width="140" HorizontalContentAlignment="Center"/>
                    <Button x:Name="BtnExecuteAll" Content="Chạy tất cả" Click="BtnExecuteAll_Click"
                            Background="#374151" Foreground="#FFFFFF" FontWeight="SemiBold"
                            CornerRadius="5" Padding="14,6" Width="140" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status & Log Output -->
        <Border Grid.Row="3" Background="#0F0F14" BorderBrush="#1F1F26" BorderThickness="1" CornerRadius="6" Padding="10,6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="TxtStatus" Text="Sẵn sàng." FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtClientCount" Grid.Column="1" Text="Đã kết nối: 0 client" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
