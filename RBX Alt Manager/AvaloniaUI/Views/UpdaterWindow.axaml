<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        x:Class="Shiro.AvaloniaUI.Views.UpdaterWindow"
        Icon="/Resources/shiro.ico"
        Title="Cập nhật hệ thống • Shiro Account Manager"
        Width="480" Height="260"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#0A0A0F"
        Foreground="#F4F4F5"
        TransparencyLevelHint="Mica, AcrylicBlur">

    <Border Background="#0C0C12" BorderBrush="#2A2A3E" BorderThickness="1" CornerRadius="12" Padding="24">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                <Border Width="36" Height="36" CornerRadius="8" ClipToBounds="True">
                    <Image Source="/Resources/shiro_logo.png" Width="36" Height="36" Stretch="UniformToFill"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Shiro Account Manager" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Trình cập nhật tự động • Auto Updater" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>

            <!-- Status & Progress -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="TxtStatus" Text="Đang kiểm tra phiên bản mới nhất..." FontSize="13" Foreground="#E2E8F0"/>
                    <TextBlock Grid.Column="1" x:Name="TxtPercent" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#60A5FA"/>
                </Grid>
                <ProgressBar x:Name="PrgUpdate" Height="8" Minimum="0" Maximum="100" Value="0"
                             Background="#1E1E2E" Foreground="#3B82F6" CornerRadius="4"/>
                <TextBlock x:Name="TxtSubStatus" Text="" FontSize="11" Foreground="#94A3B8"/>
            </StackPanel>

            <!-- Error buttons -->
            <StackPanel Grid.Row="2" x:Name="PnlErrorActions" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" IsVisible="False">
                <Button Content="Thử lại" Click="BtnRetry_Click"
                        Background="#2563EB" Foreground="#FFFFFF" CornerRadius="5" Padding="14,6" FontSize="12"/>
                <Button Content="Đóng" Click="BtnClose_Click"
                        Background="#272730" Foreground="#D4D4D8" CornerRadius="5" Padding="14,6" FontSize="12"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
