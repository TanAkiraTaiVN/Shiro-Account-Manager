<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             mc:Ignorable="d"
             x:Class="RBX_Alt_Manager.AvaloniaUI.Views.SettingsView">

    <UserControl.Styles>
        <Style Selector="RadioButton.SettingsTabPill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.SettingsTabPill:checked">
            <Setter Property="Background" Value="#22222E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="RadioButton.SettingsTabPill:pointerover">
            <Setter Property="Background" Value="#1A1A24" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,16,24,16">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Set_Title}" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" />
            <TextBlock Text="{DynamicResource Set_Subtitle}" FontSize="12" Foreground="#A1A1AA" />
        </StackPanel>

        <!-- Category Tabs -->
        <Border Grid.Row="1" Background="#111115" BorderBrush="#24242C" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <RadioButton x:Name="TabRadioGeneral" Classes="SettingsTabPill" GroupName="SettingsCat" IsChecked="True" Click="OnCategoryTabClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:Lucide Icon="Settings" Width="14" Height="14" StrokeBrush="#A1A1AA" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Set_TabGeneral}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TabRadioPerformance" Classes="SettingsTabPill" GroupName="SettingsCat" Click="OnCategoryTabClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:Lucide Icon="Zap" Width="14" Height="14" StrokeBrush="#A1A1AA" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Set_TabPerformance}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TabRadioLaunching" Classes="SettingsTabPill" GroupName="SettingsCat" Click="OnCategoryTabClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:Lucide Icon="Play" Width="14" Height="14" StrokeBrush="#A1A1AA" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Set_TabLaunch}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TabRadioSecurity" Classes="SettingsTabPill" GroupName="SettingsCat" Click="OnCategoryTabClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:Lucide Icon="Lock" Width="14" Height="14" StrokeBrush="#A1A1AA" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Set_TabSecurity}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="TabRadioPresets" Classes="SettingsTabPill" GroupName="SettingsCat" Click="OnCategoryTabClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:Lucide Icon="Sparkles" Width="14" Height="14" StrokeBrush="#A1A1AA" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Set_TabPresets}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Main Settings Body -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left" Spacing="16">

                <!-- 1. CATEGORY: GENERAL & INTERFACE -->
                <Border x:Name="PanelGeneral" Background="#111115" BorderBrush="#24242C" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{DynamicResource Set_SectionUI}" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" />

                        <!-- Language -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_Language}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_LanguageTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="CmbLanguage" SelectedIndex="0" Width="160" SelectionChanged="OnLanguageChanged"
                                      HorizontalAlignment="Right" Background="#18181F" Foreground="#FFFFFF" BorderBrush="#2E2E38">
                                <ComboBoxItem Content="Tiếng Việt (VN)" />
                                <ComboBoxItem Content="English (US/UK)" />
                            </ComboBox>
                        </Grid>

                        <Separator Background="#24242C" Height="1" />

                        <!-- Accent Theme Colors -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_Theme}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_ThemeTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Name="BtnThemeMonochrome" Content="Trắng" Click="OnThemeMonochromeClicked" Background="#24242C" Foreground="#FFFFFF" CornerRadius="6" Padding="12,6" FontSize="11" Cursor="Hand" />
                                <Button x:Name="BtnThemeViolet" Content="Violet" Click="OnThemeVioletClicked" Background="#2E1C44" Foreground="#D8B4FE" CornerRadius="6" Padding="12,6" FontSize="11" Cursor="Hand" />
                                <Button x:Name="BtnThemeCyan" Content="Cyan" Click="OnThemeCyanClicked" Background="#112938" Foreground="#38BDF8" CornerRadius="6" Padding="12,6" FontSize="11" Cursor="Hand" />
                                <Button x:Name="BtnThemeEmerald" Content="Emerald" Click="OnThemeEmeraldClicked" Background="#122B1E" Foreground="#34D399" CornerRadius="6" Padding="12,6" FontSize="11" Cursor="Hand" />
                                <Button x:Name="BtnThemePink" Content="Pink" Click="OnThemePinkClicked" Background="#381525" Foreground="#F472B6" CornerRadius="6" Padding="12,6" FontSize="11" Cursor="Hand" />
                            </StackPanel>
                        </Grid>

                        <Separator Background="#24242C" Height="1" />

                        <!-- Hide Usernames (Streamer Mode) -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_StreamerMode}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_StreamerModeTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="SwHideUsernames" IsChecked="False" HorizontalAlignment="Right" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>

                        <Separator Background="#24242C" Height="1" />

                        <!-- Auto Check Updates -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_AutoUpdate}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_AutoUpdateTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="SwCheckUpdates" IsChecked="True" HorizontalAlignment="Right" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. CATEGORY: PERFORMANCE & FASTFLAGS -->
                <Border x:Name="PanelPerformance" IsVisible="False" Background="#111115" BorderBrush="#24242C" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{DynamicResource Set_SectionPerf}" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" />

                        <!-- Unlock FPS -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_UnlockFps}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_UnlockFpsTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="SwUnlockFps" IsChecked="False" HorizontalAlignment="Right" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_TargetFps}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_TargetFpsTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" x:Name="NumTargetFps" Minimum="30" Maximum="360" Value="144" Width="120"
                                           HorizontalAlignment="Right" Background="#18181F" Foreground="#FFFFFF" BorderBrush="#2E2E38" />
                        </Grid>

                        <Separator Background="#24242C" Height="1" />

                        <!-- Potato Mode -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_PotatoMode}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_PotatoModeTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="SwPotatoMode" IsChecked="False" HorizontalAlignment="Right" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>

                        <Separator Background="#24242C" Height="1" />

                        <!-- Multi-Roblox -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_MultiRbx}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_MultiRbxTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="SwMultiRbx" IsChecked="True" HorizontalAlignment="Right" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>

                        <Separator Background="#24242C" Height="1" />

                        <!-- Anti-AFK -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_AntiAfk}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_AntiAfkTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="SwAntiAfk" IsChecked="True" HorizontalAlignment="Right" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>

                        <Separator Background="#24242C" Height="1" />

                        <!-- Auto-Mute Background Roblox (WASAPI) -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_AutoMute}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_AutoMuteTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="SwAutoMute" IsChecked="False" HorizontalAlignment="Right" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>

                        <Separator Background="#24242C" Height="1" />

                        <!-- Aggressive RAM Trimming -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_AggressiveRamTrim}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_AggressiveRamTrimTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="SwAggressiveRamTrim" IsChecked="True" HorizontalAlignment="Right" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. CATEGORY: LAUNCHING & NETWORK -->
                <Border x:Name="PanelLaunching" IsVisible="False" Background="#111115" BorderBrush="#24242C" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{DynamicResource Set_SectionLaunch}" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" />

                        <!-- Smart Fast Launch (Zero Delay Queue) -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_SmartFastLaunch}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_SmartFastLaunchTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="SwSmartFastLaunch" IsChecked="True" HorizontalAlignment="Right" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>

                        <Separator Background="#24242C" Height="1" />

                        <!-- Join Delay -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_JoinDelay}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_JoinDelayTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" x:Name="NumJoinDelay" Minimum="1" Maximum="3600" Value="8" Width="120"
                                           HorizontalAlignment="Right" Background="#18181F" Foreground="#FFFFFF" BorderBrush="#2E2E38" />
                        </Grid>

                        <Separator Background="#24242C" Height="1" />

                        <!-- Proxy Support -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_UseProxies}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_UseProxiesTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="SwUseProxies" IsChecked="False" HorizontalAlignment="Right" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>

                        <Separator Background="#24242C" Height="1" />

                        <!-- WebServer Integration -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_EnableWebServer}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_EnableWebServerTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="SwEnableWebServer" IsChecked="False" HorizontalAlignment="Right" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_WebServerPort}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_WebServerPortTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" x:Name="NumWebServerPort" Minimum="1024" Maximum="65535" Value="7963" Width="120"
                                           HorizontalAlignment="Right" Background="#18181F" Foreground="#FFFFFF" BorderBrush="#2E2E38" />
                        </Grid>

                        <Separator Background="#24242C" Height="1" />

                        <!-- Nexus Port -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_NexusPort}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_NexusPortTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" x:Name="NumNexusPort" Minimum="1024" Maximum="65535" Value="5242" Width="120"
                                           HorizontalAlignment="Right" Background="#18181F" Foreground="#FFFFFF" BorderBrush="#2E2E38" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. CATEGORY: SECURITY & DATA -->
                <Border x:Name="PanelSecurity" IsVisible="False" Background="#111115" BorderBrush="#24242C" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{DynamicResource Set_SectionSecurity}" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" />

                        <!-- Auto Cookie Refresh -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_AutoCookie}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_AutoCookieTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="SwAutoCookie" IsChecked="True" HorizontalAlignment="Right" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>

                        <Separator Background="#24242C" Height="1" />

                        <!-- Save Passwords -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_SavePasswords}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_SavePasswordsTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="SwSavePasswords" IsChecked="True" HorizontalAlignment="Right" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>

                        <Separator Background="#24242C" Height="1" />

                        <!-- Master Password Encryption -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_MasterPassword}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_MasterPasswordTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <Button Grid.Column="1" HorizontalAlignment="Right" Click="OnChangeMasterPasswordClicked"
                                    Background="#18181F" Foreground="#FFFFFF" BorderBrush="#2E2E38" BorderThickness="1"
                                    CornerRadius="6" Padding="14,8" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <lucide:Lucide Icon="Key" Width="13" Height="13" StrokeBrush="#F59E0B" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Set_ChangeMasterPassBtn}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Separator Background="#24242C" Height="1" />

                        <!-- Maintenance Utilities -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Set_Maintenance}" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock Text="{DynamicResource Set_MaintenanceTip}" FontSize="11" Foreground="#A1A1AA" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Click="OnCleanTrayClicked"
                                        Background="#18181F" Foreground="#A1A1AA" BorderBrush="#2E2E38" BorderThickness="1"
                                        CornerRadius="6" Padding="12,8" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <lucide:Lucide Icon="RefreshCw" Width="13" Height="13" StrokeBrush="#A1A1AA" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Set_CleanTrayBtn}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnClearAvatarCacheClicked"
                                        Background="#18181F" Foreground="#A1A1AA" BorderBrush="#2E2E38" BorderThickness="1"
                                        CornerRadius="6" Padding="12,8" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <lucide:Lucide Icon="Trash2" Width="13" Height="13" StrokeBrush="#EF4444" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Set_ClearAvatarCacheBtn}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 5. CATEGORY: 1-CLICK PRESETS -->
                <Border x:Name="PanelPresets" IsVisible="False" Background="#111115" BorderBrush="#24242C" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{DynamicResource Set_SectionPresets}" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" />
                        <TextBlock Text="{DynamicResource Set_PresetsSubtitle}" FontSize="12" Foreground="#A1A1AA" />

                        <!-- Preset 1: Safe Mode -->
                        <Border Background="#16161D" BorderBrush="#24242C" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <lucide:Lucide Icon="ShieldCheck" Width="15" Height="15" StrokeBrush="#38BDF8" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Set_PresetSafeTitle}" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Set_PresetSafeDesc}" FontSize="11" Foreground="#A1A1AA" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{DynamicResource Set_ApplyPresetBtn}" Click="OnApplyPresetSafeClicked"
                                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="6" Padding="16,8" Cursor="Hand" />
                            </Grid>
                        </Border>

                        <!-- Preset 2: AFK Farm -->
                        <Border Background="#16161D" BorderBrush="#24242C" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <lucide:Lucide Icon="Cpu" Width="15" Height="15" StrokeBrush="#22C55E" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Set_PresetAfkTitle}" FontWeight="Bold" FontSize="14" Foreground="#22C55E" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Set_PresetAfkDesc}" FontSize="11" Foreground="#A1A1AA" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{DynamicResource Set_ApplyPresetBtn}" Click="OnApplyPresetAfkClicked"
                                        Background="#16A34A" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="6" Padding="16,8" Cursor="Hand" />
                            </Grid>
                        </Border>

                        <!-- Preset 3: Ultra Potato -->
                        <Border Background="#16161D" BorderBrush="#24242C" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <lucide:Lucide Icon="Zap" Width="15" Height="15" StrokeBrush="#F59E0B" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Set_PresetPotatoTitle}" FontWeight="Bold" FontSize="14" Foreground="#F59E0B" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Set_PresetPotatoDesc}" FontSize="11" Foreground="#A1A1AA" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{DynamicResource Set_ApplyPresetBtn}" Click="OnApplyPresetPotatoClicked"
                                        Background="#D97706" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="6" Padding="16,8" Cursor="Hand" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Save Action Bar -->
        <Border Grid.Row="3" Background="#111115" BorderBrush="#24242C" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,16,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Click="OnSaveSettingsClicked"
                        Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}" FontWeight="Bold"
                        CornerRadius="6" Padding="20,10" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <lucide:Lucide Icon="Save" Width="15" Height="15" StrokeBrush="#09090B" StrokeThickness="2.5" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Set_SaveSettings}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1" x:Name="TxtSaveFeedback" Text="" Foreground="#22C55E" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16,0,0,0" FontSize="12" />
            </Grid>
        </Border>

    </Grid>
</UserControl>
