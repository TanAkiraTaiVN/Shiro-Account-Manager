<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'RBX_Alt_Manager.Tests'">
    <!-- Keep generated intermediate files with the other build artifacts so
         the source tree contains only source, resources and project files. -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)build\artifacts\obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
