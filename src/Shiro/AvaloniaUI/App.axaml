<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Shiro.AvaloniaUI.Converters"
             x:Class="Shiro.AvaloniaUI.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <conv:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmpty" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:EqualityToBooleanConverter x:Key="EqualityToBoolean" />
        <conv:GroupNameDisplayConverter x:Key="GroupNameDisplay" />

        <!-- Status Brushes -->
        <SolidColorBrush x:Key="GreenBrush">#22C55E</SolidColorBrush>
        <SolidColorBrush x:Key="RedBrush">#EF4444</SolidColorBrush>
        <SolidColorBrush x:Key="AmberBrush">#F59E0B</SolidColorBrush>
        <SolidColorBrush x:Key="BlueBrush">#38BDF8</SolidColorBrush>
        <SolidColorBrush x:Key="PurpleBrush">#A855F7</SolidColorBrush>
        <SolidColorBrush x:Key="MutedTextBrush">#A1A1AA</SolidColorBrush>
        <SolidColorBrush x:Key="SubtleBorderBrush">#24242C</SolidColorBrush>
        <SolidColorBrush x:Key="CardBackgroundBrush">#14141A</SolidColorBrush>
        <SolidColorBrush x:Key="SurfaceBackgroundBrush">#111115</SolidColorBrush>

        <!-- Pre-parsed GPU-Cached StreamGeometries for Zero-Allocation Virtualized Rows -->
        <StreamGeometry x:Key="GeoPlay">M 6,3 L 20,12 L 6,21 Z</StreamGeometry>
        <StreamGeometry x:Key="GeoTrash">M 3,6 L 21,6 M 19,6 L 19,20 C 19,21.1 18.1,22 17,22 L 7,22 C 5.9,22 5,21.1 5,20 L 5,6 M 8,6 L 8,4 C 8,2.9 8.9,2 10,2 L 14,2 C 15.1,2 16,2.9 16,4 L 16,6 M
            10,11 L 10,17 M 14,11 L 14,17</StreamGeometry>
        <StreamGeometry x:Key="GeoExternalLink">M 15,3 L 21,3 L 21,9 M 10,14 L 21,3 M 18,13 L 18,19 C 18,20.1 17.1,21 16,21 L 5,21 C 3.9,21 3,20.1 3,19 L 3,8 C 3,6.9 3.9,6 5,6 L
            11,6</StreamGeometry>
        <StreamGeometry x:Key="GeoKey">M 21,2 L 19,4 M 11.4,11.6 C 13.5,13.7 13.5,17.2 11.4,19.4 C 9.2,21.5 5.8,21.5 3.6,19.4 C 1.5,17.2 1.5,13.7 3.6,11.6 C 5.8,9.5 9.2,9.5 11.4,11.6 Z M
            11.4,11.6 L 21,2 M 16,7 L 19,10</StreamGeometry>
        <StreamGeometry x:Key="GeoShieldAlert">M 12,22 C 12,22 20,18 20,12 L 20,5 L 12,2 L 4,5 L 4,12 C 4,18 12,22 12,22 Z M 12,8 L 12,13 M 12,16.5 L 12.02,16.5</StreamGeometry>
        <StreamGeometry x:Key="GeoPin">M 12,17 L 12,22 M 9,10.8 L 6,13.5 L 5,15.2 L 5,17 L 19,17 L 19,15.2 L 18,13.5 L 15,10.8 L 15,4 L 17,4 L 17,2 L 7,2 L 7,4 L 9,4 Z</StreamGeometry>
        <StreamGeometry x:Key="GeoEllipsis">M 4,12 A 1.5,1.5 0 1 1 7,12 A 1.5,1.5 0 1 1 4,12 Z M 10.5,12 A 1.5,1.5 0 1 1 13.5,12 A 1.5,1.5 0 1 1 10.5,12 Z M 17,12 A 1.5,1.5 0 1 1 20,12 A 1.5,1.5
            0 1 1 17,12 Z</StreamGeometry>
        <StreamGeometry x:Key="GeoCopy">M 9,9 L 19,9 C 20.1,9 21,9.9 21,11 L 21,20 C 21,21.1 20.1,22 19,22 L 9,22 C 7.9,22 7,21.1 7,20 L 7,11 C 7,9.9 7.9,9 9,9 Z M 5,15 L 4,15 C 2.9,15 2,14.1
            2,13 L 2,4 C 2,2.9 2.9,2 4,2 L 13,2 C 14.1,2 15,2.9 15,4 L 15,5</StreamGeometry>
        <StreamGeometry x:Key="GeoMapPin">M 20,10 C 20,16 12,22 12,22 C 12,22 4,16 4,10 C 4,5.6 7.6,2 12,2 C 16.4,2 20,5.6 20,10 Z M 9,10 A 3,3 0 1 0 15,10 A 3,3 0 1 0 9,10 Z</StreamGeometry>
        <StreamGeometry x:Key="GeoWindow">M 3,5 C 3,3.9 3.9,3 5,3 L 19,3 C 20.1,3 21,3.9 21,5 L 21,19 C 21,20.1 20.1,21 19,21 L 5,21 C 3.9,21 3,20.1 3,19 Z M 3,8 L 21,8</StreamGeometry>
        <StreamGeometry x:Key="GeoClose">M 18,6 L 6,18 M 6,6 L 18,18</StreamGeometry>
        <StreamGeometry x:Key="GeoCheck">M 20,6 L 9,17 L 4,12</StreamGeometry>
        <StreamGeometry x:Key="GeoInfo">M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z M 12,16 L 12,12 M 12,8 L 12.01,8</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Shiro/AvaloniaUI/Styles/ViewStyles.axaml" />

        <!-- Allow horizontal ProgressBar to shrink and respect custom width without default Fluent 200px MinWidth -->
        <Style Selector="ProgressBar:horizontal">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- Disable Fluent auto-hide scrollbar delay/scale animations for instant 1:1 thumb dragging -->
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>

        <!-- Zero-Transition Ultra-Lightweight Buttons for Virtualized Lists/Cards -->
        <Style Selector="Button.FastIconBtn">
            <Setter Property="Transitions" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.FastIconBtn:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="#22222E" />
        </Style>
        <Style Selector="Button.FastIconBtn:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="#2C2C3C" />
        </Style>

        <Style Selector="Button.FastPillBtn">
            <Setter Property="Transitions" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.FastPillBtn:pointerover /template/ Border#PART_Border">
            <Setter Property="Opacity" Value="0.88" />
        </Style>
        <Style Selector="Button.FastPillBtn:pressed /template/ Border#PART_Border">
            <Setter Property="Opacity" Value="0.75" />
        </Style>

        <!-- Sleek Zero-Latency ScrollBar Styling across entire Application -->
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False" />
            <Setter Property="Transitions" Value="{x:Null}" />
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="Transitions" Value="{x:Null}" />
            <Setter Property="RenderTransform" Value="{x:Null}" />
            <Setter Property="Background" Value="#3E3E52" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="ScrollBar:vertical:pointerover /template/ Thumb">
            <Setter Property="Background" Value="#636382" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb:pressed">
            <Setter Property="Background" Value="#8B8BA8" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ RepeatButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="12" />
            <Setter Property="MinHeight" Value="12" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar:horizontal /template/ Thumb">
            <Setter Property="Transitions" Value="{x:Null}" />
            <Setter Property="RenderTransform" Value="{x:Null}" />
            <Setter Property="Background" Value="#3E3E52" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Height" Value="8" />
            <Setter Property="MinHeight" Value="8" />
            <Setter Property="MinWidth" Value="28" />
        </Style>
        <Style Selector="ScrollBar:horizontal:pointerover /template/ Thumb">
            <Setter Property="Background" Value="#636382" />
        </Style>
        <Style Selector="ScrollBar:horizontal /template/ Thumb:pressed">
            <Setter Property="Background" Value="#8B8BA8" />
        </Style>
        <Style Selector="ScrollBar:horizontal /template/ RepeatButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </Application.Styles>
</Application>
