<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        xmlns:dlg="clr-namespace:Shiro.ViewModels.Dialogs"
        x:Class="Shiro.AvaloniaUI.Views.BulkImportDialog"
        x:DataType="dlg:BulkImportViewModel"
        Icon="/Resources/shiro.ico"
        Title="{DynamicResource Loc_BulkImport_WindowTitle}"
        Width="640" Height="580"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#0D0D11">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">
        <!-- Title & Subtitle -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,10,0,14">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="#252536" CornerRadius="8" Width="36" Height="36">
                    <lucide:Lucide Icon="Download" Width="18" Height="18" StrokeBrush="#818CF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_BulkImport_DialogHeading}" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="{DynamicResource Loc_BulkImport_DialogSubtitle}" FontSize="12" Foreground="#71717A" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Editor Box -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto">
            <TextBox x:Name="TxtImportData"
                     Text="{Binding InputText, Mode=TwoWay}"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     Watermark="{DynamicResource Loc_BulkImport_InputWatermark}"
                     Background="#14141C" Foreground="#FFFFFF" BorderBrush="#272733"
                     CornerRadius="8" Padding="12" FontFamily="Consolas, monospace" FontSize="11" />

            <!-- Quick Format Hint -->
            <TextBlock Grid.Row="1" Text="{DynamicResource Loc_BulkImport_SupportedFormatNote}"
                       FontSize="11" Foreground="#71717A" Margin="4,6,0,0" />
        </Grid>

        <!-- Status & Stats Bar -->
        <Border Grid.Row="2" Background="#14141C" BorderBrush="#272733" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="TxtStatus"
                           Text="{Binding StatusText}"
                           Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}"
                           FontSize="12" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" x:Name="PrgProgress"
                             Width="140" Height="6" MinWidth="0" MinHeight="0"
                             Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"
                             IsVisible="{Binding IsProgressVisible}"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Bottom Action Buttons -->
        <Border Grid.Row="3" Margin="0,14,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" x:Name="BtnClear"
                        Command="{Binding ClearCommand}"
                        Background="#1E1E2A" Foreground="#A1A1AA"
                        CornerRadius="6" Padding="14,8" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:Lucide Icon="Trash2" Width="13" Height="13" StrokeBrush="#A1A1AA" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc_BulkImport_ClearContentBtn}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnClose"
                            Command="{Binding CloseCommand}"
                            Background="Transparent" Foreground="#A1A1AA"
                            CornerRadius="6" Padding="16,8" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:Lucide Icon="X" Width="13" Height="13" StrokeBrush="#A1A1AA" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Loc_Btn_Close}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnStartImport"
                            Command="{Binding StartImportCommand}"
                            Background="#FFFFFF" Foreground="#09090B" FontWeight="Bold"
                            CornerRadius="6" Padding="20,8" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:Lucide Icon="Check" Width="13" Height="13" StrokeBrush="#09090B" StrokeThickness="2.5" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Loc_Bulk_BtnStart}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
