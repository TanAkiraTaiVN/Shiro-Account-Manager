<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        xmlns:controls="clr-namespace:Shiro.AvaloniaUI.Controls"
        x:Class="Shiro.AvaloniaUI.Views.FastLoginDialog"
        Icon="/Resources/shiro.ico"
        Title="Roblox Login - Shiro"
        Width="460" Height="580"
        MinWidth="400" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#0D0D11">

    <Window.Styles>
        <Style Selector="RadioButton.ModeTabPill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.ModeTabPill:checked">
            <Setter Property="Background" Value="#1E1E2C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="RadioButton.ModeTabPill:pointerover">
            <Setter Property="Background" Value="#161622" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <!-- Header Row -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Background="#252536" CornerRadius="8" Width="30" Height="30">
                    <lucide:Lucide Icon="LogIn" Width="15" Height="15" StrokeBrush="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtDialogTitle" Text="Đăng nhập tài khoản" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock x:Name="TxtDialogSubtitle" Text="Tự động bắt phiên và lưu tài khoản" FontSize="11" Foreground="#71717A" />
                </StackPanel>
            </StackPanel>

            <!-- Mode Tabs (In-App vs Dán Cookie) -->
            <Border Grid.Column="1" Background="#14141C" BorderBrush="#242432" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <RadioButton x:Name="TabInApp" Classes="ModeTabPill"
                                 GroupName="LoginModeGroup" IsChecked="True"
                                 IsCheckedChanged="OnModeCheckedChanged">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <lucide:Lucide Icon="Globe" Width="12" Height="12" StrokeBrush="#38BDF8" VerticalAlignment="Center" />
                            <TextBlock Text="In-App" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabCookie" Classes="ModeTabPill"
                                 GroupName="LoginModeGroup" IsChecked="False"
                                 IsCheckedChanged="OnModeCheckedChanged">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <lucide:Lucide Icon="Cookie" Width="12" Height="12" StrokeBrush="#F59E0B" VerticalAlignment="Center" />
                            <TextBlock Text="Cookie" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Body Area -->
        <Panel Grid.Row="1">
            <!-- ================= MODE 1: IN-APP WEBVIEW2 BROWSER ================= -->
            <Grid x:Name="PnlInApp" RowDefinitions="Auto,*" IsVisible="True">
                <!-- In-App Mini Toolbar -->
                <Border Grid.Row="0" Background="#14141C" BorderBrush="#242432" BorderThickness="1" CornerRadius="6,6,0,0" Padding="10,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Live Status Text -->
                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse Grid.Column="0" Width="6" Height="6" Fill="#38BDF8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" x:Name="TxtInAppStatus" Text="Đang khởi tạo trình duyệt..."
                                       FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <!-- Controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="BtnRefill" Click="OnRefillClicked"
                                    Background="#1E1E2A" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold"
                                    CornerRadius="5" Padding="8,3" Cursor="Hand" IsVisible="False">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <lucide:Lucide Icon="Key" Width="11" Height="11" StrokeBrush="#38BDF8" VerticalAlignment="Center" />
                                    <TextBlock Text="Điền &amp; Login" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnSkipNext" Click="OnSkipNextClicked"
                                    Background="#1E1E2A" Foreground="#F59E0B" FontSize="11" FontWeight="SemiBold"
                                    CornerRadius="5" Padding="8,3" Cursor="Hand" IsVisible="False">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="Bỏ qua" VerticalAlignment="Center" />
                                    <lucide:Lucide Icon="ArrowRight" Width="11" Height="11" StrokeBrush="#F59E0B" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnReload" Click="OnReloadClicked"
                                    Background="#1E1E2A" Foreground="#FFFFFF"
                                    CornerRadius="5" Padding="6,3" Cursor="Hand" ToolTip.Tip="Tải lại trang">
                                <lucide:Lucide Icon="RefreshCw" Width="12" Height="12" StrokeBrush="#A1A1AA" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Embedded Browser Host -->
                <Border Grid.Row="1" Background="#0D0D11" BorderBrush="#242432" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" ClipToBounds="True">
                    <controls:WebView2Control x:Name="WvBrowser"
                                              CoreWebView2InitializationCompleted="OnWebViewInitialized" />
                </Border>
            </Grid>

            <!-- ================= MODE 2: PASTE COOKIE ================= -->
            <ScrollViewer x:Name="PnlCookie" VerticalScrollBarVisibility="Auto" IsVisible="False">
                <StackPanel Spacing="12" Margin="10,8">
                    <!-- Cookie input -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="Roblox Cookie (.ROBLOSECURITY):" FontSize="11" FontWeight="SemiBold" Foreground="#D4D4D8" />
                        <TextBox x:Name="TxtCookie" Watermark="_|WARNING:-DO-NOT-SHARE-THIS..."
                                 Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                                 Background="#14141C" Foreground="#FFFFFF" BorderBrush="#272733"
                                 CornerRadius="6" Padding="8" FontSize="11" />
                    </StackPanel>

                    <!-- Alias & Group -->
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,4,0">
                            <TextBlock Text="Alias (Tùy chọn):" FontSize="11" FontWeight="SemiBold" Foreground="#D4D4D8" />
                            <TextBox x:Name="TxtCookieAlias" Watermark="e.g. Main Farm"
                                     Background="#14141C" Foreground="#FFFFFF" BorderBrush="#272733"
                                     CornerRadius="6" Padding="8,6" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5" Margin="4,0,0,0">
                            <TextBlock Text="Nhóm (Tùy chọn):" FontSize="11" FontWeight="SemiBold" Foreground="#D4D4D8" />
                            <TextBox x:Name="TxtCookieGroup" Watermark="e.g. Alts"
                                     Background="#14141C" Foreground="#FFFFFF" BorderBrush="#272733"
                                     CornerRadius="6" Padding="8,6" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <!-- Status & Preview Card -->
                    <Border Background="#14141C" BorderBrush="#272733" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="36" Height="36" CornerRadius="18" Background="#1E1E2A">
                                    <lucide:Lucide Icon="User" Width="18" Height="18" StrokeBrush="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="TxtPreviewUsername" Text="Chờ xác thực Cookie" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock x:Name="TxtPreviewStatus" Text="Dán chuỗi cookie ở trên và bấm Verify" FontSize="11" Foreground="#A1A1AA" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Panel>

        <!-- Footer Row -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <!-- Left Info -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                <lucide:Lucide Icon="Info" Width="13" Height="13" StrokeBrush="#38BDF8" VerticalAlignment="Center"
                               IsVisible="{Binding #TxtTip.IsVisible}" />
                <TextBlock x:Name="TxtTip" Text="Cửa sổ sẽ tự đóng khi đăng nhập xong."
                           FontSize="11" Foreground="#71717A" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" IsVisible="True" />
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button x:Name="BtnVerify" Click="OnVerifyClicked"
                        Background="#1E1E2A" Foreground="#FFFFFF" FontWeight="SemiBold"
                        CornerRadius="6" Padding="12,6" FontSize="11" Cursor="Hand" IsVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <lucide:Lucide Icon="ShieldCheck" Width="12" Height="12" StrokeBrush="#38BDF8" VerticalAlignment="Center" />
                        <TextBlock Text="Verify" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnAddCookie" Click="OnAddClicked"
                        Background="#FFFFFF" Foreground="#09090B" FontWeight="Bold"
                        CornerRadius="6" Padding="14,6" FontSize="11" Cursor="Hand" IsVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <lucide:Lucide Icon="Plus" Width="12" Height="12" StrokeBrush="#09090B" StrokeThickness="2.5" VerticalAlignment="Center" />
                        <TextBlock Text="Thêm Tài Khoản" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnCancel" Click="OnCancelClicked"
                        Background="#1E1E2A" Foreground="#A1A1AA"
                        CornerRadius="6" Padding="14,6" FontSize="11" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <lucide:Lucide Icon="X" Width="12" Height="12" StrokeBrush="#A1A1AA" VerticalAlignment="Center" />
                        <TextBlock Text="Đóng" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>