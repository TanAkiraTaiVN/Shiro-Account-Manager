<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Shiro.ViewModels.Dialogs"
        xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        x:Class="Shiro.AvaloniaUI.Views.MissingAssetsDialog"
        x:DataType="vm:MissingAssetsViewModel"
        x:CompileBindings="True"
        x:Name="RootWindow"
        Icon="/Resources/shiro.ico"
        Title="{DynamicResource Loc_MissingAssets_WindowTitle}"
        Width="656" Height="530"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceChromeBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TransparencyLevelHint="Mica, AcrylicBlur">

    <Border Background="{DynamicResource SurfacePanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusXl}"
            BoxShadow="{StaticResource ShadowModal}"
            Margin="10">
        <Panel>
            <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="18">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center" Margin="0,0,0,14">
                    <Border Width="38" Height="38" CornerRadius="{StaticResource RadiusLg}"
                            Background="{DynamicResource AccentSoftFillBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                        <lucide:Lucide Icon="ShoppingBag" Width="17" Height="17"
                                       StrokeBrush="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTitle" Text="{Binding Title}" FontSize="16"
                                   FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="TxtSubtitle" Text="{Binding Subtitle}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}" Padding="6" Margin="0,0,0,12">
                    <ListBox x:Name="AssetsListBox" ItemsSource="{Binding Items}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MissingAssetDisplayItem">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="8,5">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="TabularNum" Text="{Binding AssetIdText}" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Classes="TabularNum" Text="{Binding PriceText}"
                                               VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource StatusInfoBrush}" Margin="0,0,12,0" />
                                    <Button Grid.Column="2" Classes="StudioSecondaryBtn"
                                            Command="{Binding #RootWindow.((vm:MissingAssetsViewModel)DataContext).ViewOnRobloxCommand}"
                                            CommandParameter="{Binding}" FontSize="11" Padding="10,5" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Data="{StaticResource GeoExternalLink}" Width="10" Height="10"
                                                  Stretch="Uniform" Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.8" StrokeLineCap="Round"
                                                  StrokeJoin="Round" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Loc_MissingAssets_ViewBtn}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="3" Classes="StudioPrimaryBtn"
                                            Content="{Binding BuyButtonText}"
                                            Command="{Binding #RootWindow.((vm:MissingAssetsViewModel)DataContext).BuyCommand}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanBuy}" FontSize="11" Padding="12,5" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border Grid.Row="2" Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}" Padding="12,8" Margin="0,0,0,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="TxtStatus" Text="{Binding StatusText}" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{DynamicResource StatusInfoBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtTotalPrice" Grid.Column="1" Classes="TabularNum"
                                   Text="{Binding TotalPriceText}" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource StatusSuccessBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Classes="StudioSecondaryBtn" Height="32" Padding="14,0"
                            Command="{Binding CloseCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:Lucide Icon="X" Width="13" Height="13"
                                           StrokeBrush="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Loc_Btn_Close}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Border IsHitTestVisible="False"
                    BorderBrush="{DynamicResource BorderTopRimBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusXl}" />
        </Panel>
    </Border>
</Window>
