<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Shiro.AvaloniaUI.Views"
        xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        x:Class="Shiro.AvaloniaUI.Views.MissingAssetsDialog"
        x:CompileBindings="True"
        Icon="/Resources/shiro.ico"
        Title="Vật phẩm trang phục còn thiếu • Missing Assets"
        Width="640" Height="520"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#0E0E12"
        Foreground="#F4F4F5"
        TransparencyLevelHint="Mica, AcrylicBlur">

    <Border BorderBrush="#272730" BorderThickness="1" CornerRadius="8" Padding="18">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,0,14">
                <Border Background="#252536" CornerRadius="8" Width="34" Height="34">
                    <lucide:Lucide Icon="ShoppingBag" Width="17" Height="17" StrokeBrush="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="Vật phẩm còn thiếu trong trang phục"
                               FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtSubtitle" Text="Tài khoản • 0 vật phẩm cần mua hoặc sở hữu"
                               FontSize="12" Foreground="#A1A1AA"/>
                </StackPanel>
            </StackPanel>

            <!-- Items List -->
            <Border Grid.Row="1" Background="#141419" BorderBrush="#24242C" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,14">
                <ListBox x:Name="AssetsListBox" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="views:MissingAssetDisplayItem">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="6,4">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="13"/>
                                    <TextBlock Text="{Binding AssetIdText}" FontSize="11" Foreground="#71717A"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PriceText}"
                                           VerticalAlignment="Center" FontSize="12" Foreground="#38BDF8" Margin="0,0,10,0"/>
                                <Button Grid.Column="2" Click="BtnViewOnRoblox_Click"
                                        Background="#272730" Foreground="#D4D4D8" FontSize="11"
                                        CornerRadius="5" Padding="10,4" Margin="0,0,10,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Path Data="{StaticResource GeoExternalLink}" Width="10" Height="10" Stretch="Uniform"
                                              Stroke="#D4D4D8" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="Xem" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Content="{Binding BuyButtonText}" Click="BtnBuy_Click"
                                        IsEnabled="{Binding CanBuy}"
                                        Background="#2563EB" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"
                                        CornerRadius="5" Padding="12,4" Cursor="Hand"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Status / Summary -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <TextBlock x:Name="TxtStatus" Text="" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTotalPrice" Grid.Column="1" Text="Tổng Robux: 0 R$" FontSize="12" FontWeight="SemiBold" Foreground="#22C55E" VerticalAlignment="Center"/>
            </Grid>

            <!-- Close Button -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Height="32" Click="BtnClose_Click"
                        Background="#272730" Foreground="#D4D4D8" FontWeight="SemiBold"
                        CornerRadius="5" Padding="14,0" Cursor="Hand"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:Lucide Icon="X" Width="13" Height="13" StrokeBrush="#D4D4D8" VerticalAlignment="Center" />
                        <TextBlock Text="Đóng" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
