<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        xmlns:services="clr-namespace:Shiro.Services"
        xmlns:dlg="clr-namespace:Shiro.ViewModels.Dialogs"
        x:Class="Shiro.AvaloniaUI.Views.ProxyManagerDialog"
        x:DataType="dlg:ProxyManagerViewModel"
        x:CompileBindings="True"
        Icon="/Resources/shiro.ico"
        Title="{DynamicResource Loc_Proxy_Title}"
        Width="748" Height="590"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource SurfaceChromeBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12"
                    VerticalAlignment="Center" Margin="0,4,0,14">
            <Border Width="38" Height="38" CornerRadius="{StaticResource RadiusLg}"
                    Background="{DynamicResource StatusInfoBgBrush}"
                    BorderBrush="{DynamicResource StatusInfoBorderBrush}" BorderThickness="1">
                <lucide:Lucide Icon="Globe" Width="18" Height="18"
                               StrokeBrush="{DynamicResource StatusInfoBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{DynamicResource Loc_Proxy_HeaderTitle}" FontSize="16"
                           FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{DynamicResource Loc_Proxy_HeaderSubtitle}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Quick Add Proxy Bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfacePanelBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusLg}" BoxShadow="{StaticResource ShadowCard}"
                Margin="0,0,0,12">
            <Panel>
                <Grid ColumnDefinitions="*,Auto" Margin="12">
                    <TextBox x:Name="TxtNewProxy" Text="{Binding NewProxyText, Mode=TwoWay}"
                             PlaceholderText="{DynamicResource Loc_Proxy_Placeholder}"
                             Padding="10,8" Margin="0,0,10,0" />
                    <Button Grid.Column="1" x:Name="BtnAddProxy" Classes="StudioPrimaryBtn"
                            Command="{Binding AddProxyCommand}" Padding="16,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:Lucide Icon="Plus" Width="13" Height="13"
                                           StrokeBrush="{DynamicResource AccentForegroundBrush}"
                                           StrokeThickness="2.4" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Loc_Proxy_BtnAdd}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BorderTopRimBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusLg}" />
            </Panel>
        </Border>

        <!-- Proxy List -->
        <Border Grid.Row="2" Background="{DynamicResource SurfacePanelBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusLg}" BoxShadow="{StaticResource ShadowCard}">
            <Panel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <ListBox x:Name="LstProxies" ItemsSource="{Binding Proxies}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="services:ProxyItem">
                                <Border Background="{DynamicResource SurfaceCardBrush}"
                                        BorderBrush="{DynamicResource BorderHairlineBrush}"
                                        BorderThickness="1" CornerRadius="{StaticResource RadiusMd}"
                                        Padding="12,9" Margin="0,2">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Border Grid.Column="0" Background="{DynamicResource AccentSoftFillBrush}"
                                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                                BorderThickness="1" CornerRadius="{StaticResource RadiusXs}"
                                                Padding="7,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProtocolUpper}" FontSize="10"
                                                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding AddressDisplay}" FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding AuthDisplay}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Classes="TabularNum"
                                                   Text="{Binding StatusText}" VerticalAlignment="Center"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{Binding StatusBrush}" Margin="0,0,14,0" />
                                        <Button Grid.Column="3" Classes="StudioIconBtn" Width="28" Height="28"
                                                Command="{Binding $parent[Window].((dlg:ProxyManagerViewModel)DataContext).DeleteProxyCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{DynamicResource Loc_Proxy_TipRemoveSingle}">
                                            <lucide:Lucide Icon="Trash" Width="13" Height="13"
                                                           StrokeBrush="{DynamicResource StatusDangerBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
                <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BorderTopRimBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusLg}" />
            </Panel>
        </Border>

        <!-- Action Footer -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnTestAll" Classes="StudioSecondaryBtn" Command="{Binding TestAllCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:Lucide Icon="Zap" Width="13" Height="13"
                                       StrokeBrush="{DynamicResource StatusWarningBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc_Proxy_BtnTestAll}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnRemoveDead" Classes="StudioDangerBtn" Command="{Binding RemoveDeadCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:Lucide Icon="Trash" Width="13" Height="13"
                                       StrokeBrush="{DynamicResource StatusDangerBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc_Proxy_BtnRemoveDead}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Grid.Column="1" x:Name="TxtStatus" Text="{Binding StatusText}"
                       Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       FontSize="12" FontWeight="SemiBold" Margin="12,0" />

            <Button Grid.Column="2" x:Name="BtnSaveClose" Classes="StudioPrimaryBtn"
                    Command="{Binding SaveCommand}" Padding="18,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:Lucide Icon="Check" Width="13" Height="13"
                                   StrokeBrush="{DynamicResource AccentForegroundBrush}"
                                   StrokeThickness="2.4" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Loc_Proxy_BtnSaveClose}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
