<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             mc:Ignorable="d"
             x:Class="Shiro.AvaloniaUI.Views.Panels.SettingsHeaderBanner"
             x:CompileBindings="True">
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,14">
        <Border Width="40" Height="40"
                CornerRadius="{StaticResource RadiusLg}"
                Background="{DynamicResource AccentSoftFillBrush}"
                BorderBrush="{DynamicResource AccentBorderBrush}"
                BorderThickness="1"
                VerticalAlignment="Center">
            <lucide:Lucide Icon="Settings" Width="18" Height="18"
                           StrokeBrush="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
        </Border>
        <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Set_Title}"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{DynamicResource Set_Subtitle}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
    </StackPanel>
</UserControl>
