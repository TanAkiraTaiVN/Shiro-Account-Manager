<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Shiro.ViewModels"
             xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             mc:Ignorable="d"
             x:Class="Shiro.AvaloniaUI.Views.Panels.DashboardInspectorPanel"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True">
    <Grid ColumnDefinitions="*,*,*,*" Margin="0,0,0,14">
        <Button Grid.Column="0" Classes="MetricCardBtn" Classes.active="{Binding IsFilterInGame}"
                Command="{Binding MetricCardInGameCommand}" Margin="0,0,6,0"
                ToolTip.Tip="{DynamicResource Dash_MetricTipPlaying}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Dash_Playing}" FontSize="10.5"
                                   FontWeight="SemiBold" Foreground="#A1A1AA" LetterSpacing="0.4" />
                    </StackPanel>
                    <TextBlock Text="{Binding InGameCount, StringFormat='{}{0} acc'}"
                               FontSize="19" FontWeight="Bold" Foreground="#F4F4F5" />
                </StackPanel>
                <Border Grid.Column="1" Background="#13261C" BorderBrush="#1C3D2A"
                        BorderThickness="1" Width="34" Height="34" CornerRadius="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <lucide:Lucide Icon="Gamepad2" Width="16" Height="16" StrokeBrush="#4ADE80"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Button>
        <Button Grid.Column="1" Classes="MetricCardBtn" Classes.active="{Binding IsFilterReady}"
                Command="{Binding MetricCardReadyCommand}" Margin="4,0"
                ToolTip.Tip="{DynamicResource Dash_MetricTipReady}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6" Fill="#38BDF8" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Dash_Ready}" FontSize="10.5"
                                   FontWeight="SemiBold" Foreground="#A1A1AA" LetterSpacing="0.4" />
                    </StackPanel>
                    <TextBlock Text="{Binding ReadyCount, StringFormat='{}{0} acc'}"
                               FontSize="19" FontWeight="Bold" Foreground="#F4F4F5" />
                </StackPanel>
                <Border Grid.Column="1" Background="#122130" BorderBrush="#1D3852"
                        BorderThickness="1" Width="34" Height="34" CornerRadius="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <lucide:Lucide Icon="Check" Width="17" Height="17" StrokeBrush="#38BDF8"
                                   StrokeThickness="2.2" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Button>
        <Button Grid.Column="2" Classes="MetricCardBtn" Classes.active="{Binding IsFilterExpired}"
                Command="{Binding MetricCardExpiredCommand}" Margin="4,0"
                ToolTip.Tip="{DynamicResource Dash_MetricTipExpired}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6" Fill="#F87171" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Dash_Expired}" FontSize="10.5"
                                   FontWeight="SemiBold" Foreground="#A1A1AA" LetterSpacing="0.4" />
                    </StackPanel>
                    <TextBlock Text="{Binding ExpiredCount, StringFormat='{}{0} acc'}"
                               FontSize="19" FontWeight="Bold" Foreground="#F4F4F5" />
                </StackPanel>
                <Border Grid.Column="1" Background="#271418" BorderBrush="#451D24"
                        BorderThickness="1" Width="34" Height="34" CornerRadius="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <lucide:Lucide Icon="ShieldAlert" Width="16" Height="16" StrokeBrush="#F87171"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Button>
        <Button Grid.Column="3" Classes="MetricCardBtn" Classes.active="{Binding IsSortRobuxDesc}"
                Command="{Binding MetricCardRobuxCommand}" Margin="6,0,0,0"
                ToolTip.Tip="{DynamicResource Dash_MetricTipRobux}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6" Fill="#F59E0B" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Dash_TotalRobux}" FontSize="10.5"
                                   FontWeight="SemiBold" Foreground="#A1A1AA" LetterSpacing="0.4" />
                    </StackPanel>
                    <TextBlock Text="{Binding TotalRobuxText}" FontSize="19" FontWeight="Bold"
                               Foreground="#F4F4F5" />
                </StackPanel>
                <Border Grid.Column="1" Background="#261E11" BorderBrush="#45351B"
                        BorderThickness="1" Width="34" Height="34" CornerRadius="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <lucide:Lucide Icon="Coins" Width="16" Height="16" StrokeBrush="#FBBF24"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Button>
    </Grid>
</UserControl>
