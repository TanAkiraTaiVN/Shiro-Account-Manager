<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Shiro.AvaloniaUI.Controls"
             xmlns:vm="clr-namespace:Shiro.ViewModels"
             xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             mc:Ignorable="d"
             x:Class="Shiro.AvaloniaUI.Views.Panels.DashboardInspectorPanel"
             x:DataType="vm:AccountCollectionViewModel"
             x:CompileBindings="True">
    <UserControl.Styles>
        <Style Selector="Button.MetricCardBtn /template/ Border#PART_MetricBorder">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.MetricCardBtn:pointerover /template/
                         Border#PART_MetricBorder">
            <Setter Property="Background" Value="#08FFFFFF" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.MetricCardBtn.active /template/
                         Border#PART_MetricBorder">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="*,*,*,*" Margin="0,0,0,14">
        <controls:SpotlightBorder Grid.Column="0"
                                  Margin="0,0,6,0"
                                  Background="{DynamicResource SurfaceCardBrush}"
                                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  CornerRadius="{StaticResource RadiusLg}"
                                  BoxShadow="{StaticResource ShadowCard}"
                                  SpotlightColor="{DynamicResource AccentColor}"
                                  SpotlightOpacity="0.08"
                                  BorderGlowOpacity="0.30"
                                  TopRimEnabled="True">
            <Button Classes="MetricCardBtn"
                    Classes.active="{Binding IsFilterInGame}"
                    Command="{Binding MetricCardInGameCommand}"
                    ToolTip.Tip="{DynamicResource Dash_MetricTipPlaying}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource StatusSuccessBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Classes="SectionKicker"
                                       Text="{DynamicResource Dash_Playing}" />
                        </StackPanel>
                        <TextBlock Classes="TabularNum"
                                   Text="{Binding InGameCount, StringFormat='{}{0} acc'}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{DynamicResource StatusSuccessBgBrush}"
                            BorderBrush="{DynamicResource StatusSuccessBorderBrush}"
                            BorderThickness="1" Width="36" Height="36"
                            CornerRadius="{StaticResource RadiusMd}"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <lucide:Lucide Icon="Gamepad2" Width="16" Height="16"
                                       StrokeBrush="{DynamicResource StatusSuccessBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>
        </controls:SpotlightBorder>

        <controls:SpotlightBorder Grid.Column="1"
                                  Margin="4,0"
                                  Background="{DynamicResource SurfaceCardBrush}"
                                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  CornerRadius="{StaticResource RadiusLg}"
                                  BoxShadow="{StaticResource ShadowCard}"
                                  SpotlightColor="{DynamicResource AccentColor}"
                                  SpotlightOpacity="0.08"
                                  BorderGlowOpacity="0.30"
                                  TopRimEnabled="True">
            <Button Classes="MetricCardBtn"
                    Classes.active="{Binding IsFilterReady}"
                    Command="{Binding MetricCardReadyCommand}"
                    ToolTip.Tip="{DynamicResource Dash_MetricTipReady}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource StatusInfoBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Classes="SectionKicker"
                                       Text="{DynamicResource Dash_Ready}" />
                        </StackPanel>
                        <TextBlock Classes="TabularNum"
                                   Text="{Binding ReadyCount, StringFormat='{}{0} acc'}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{DynamicResource StatusInfoBgBrush}"
                            BorderBrush="{DynamicResource StatusInfoBorderBrush}"
                            BorderThickness="1" Width="36" Height="36"
                            CornerRadius="{StaticResource RadiusMd}"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <lucide:Lucide Icon="Check" Width="17" Height="17"
                                       StrokeBrush="{DynamicResource StatusInfoBrush}"
                                       StrokeThickness="2.2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>
        </controls:SpotlightBorder>

        <controls:SpotlightBorder Grid.Column="2"
                                  Margin="4,0"
                                  Background="{DynamicResource SurfaceCardBrush}"
                                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  CornerRadius="{StaticResource RadiusLg}"
                                  BoxShadow="{StaticResource ShadowCard}"
                                  SpotlightColor="{DynamicResource AccentColor}"
                                  SpotlightOpacity="0.08"
                                  BorderGlowOpacity="0.30"
                                  TopRimEnabled="True">
            <Button Classes="MetricCardBtn"
                    Classes.active="{Binding IsFilterExpired}"
                    Command="{Binding MetricCardExpiredCommand}"
                    ToolTip.Tip="{DynamicResource Dash_MetricTipExpired}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource StatusDangerBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Classes="SectionKicker"
                                       Text="{DynamicResource Dash_Expired}" />
                        </StackPanel>
                        <TextBlock Classes="TabularNum"
                                   Text="{Binding ExpiredCount, StringFormat='{}{0} acc'}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{DynamicResource StatusDangerBgBrush}"
                            BorderBrush="{DynamicResource StatusDangerBorderBrush}"
                            BorderThickness="1" Width="36" Height="36"
                            CornerRadius="{StaticResource RadiusMd}"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <lucide:Lucide Icon="ShieldAlert" Width="16" Height="16"
                                       StrokeBrush="{DynamicResource StatusDangerBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>
        </controls:SpotlightBorder>

        <controls:SpotlightBorder Grid.Column="3"
                                  Margin="6,0,0,0"
                                  Background="{DynamicResource SurfaceCardBrush}"
                                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  CornerRadius="{StaticResource RadiusLg}"
                                  BoxShadow="{StaticResource ShadowCard}"
                                  SpotlightColor="{DynamicResource AccentColor}"
                                  SpotlightOpacity="0.08"
                                  BorderGlowOpacity="0.30"
                                  TopRimEnabled="True">
            <Button Classes="MetricCardBtn"
                    Classes.active="{Binding IsSortRobuxDesc}"
                    Command="{Binding MetricCardRobuxCommand}"
                    ToolTip.Tip="{DynamicResource Dash_MetricTipRobux}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource StatusWarningBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Classes="SectionKicker"
                                       Text="{DynamicResource Dash_TotalRobux}" />
                        </StackPanel>
                        <TextBlock Classes="TabularNum"
                                   Text="{Binding TotalRobuxText}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{DynamicResource StatusWarningBgBrush}"
                            BorderBrush="{DynamicResource StatusWarningBorderBrush}"
                            BorderThickness="1" Width="36" Height="36"
                            CornerRadius="{StaticResource RadiusMd}"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <lucide:Lucide Icon="Coins" Width="16" Height="16"
                                       StrokeBrush="{DynamicResource StatusWarningBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>
        </controls:SpotlightBorder>
    </Grid>
</UserControl>
