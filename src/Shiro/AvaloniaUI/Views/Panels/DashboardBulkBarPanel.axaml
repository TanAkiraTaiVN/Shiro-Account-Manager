<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Shiro.ViewModels"
             xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             mc:Ignorable="d"
             x:Class="Shiro.AvaloniaUI.Views.Panels.DashboardBulkBarPanel"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True">
    <Border Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="14"
            BoxShadow="{StaticResource ShadowFloating}">
        <Panel>
            <Border BorderBrush="{DynamicResource BorderTopRimBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="13"
                    IsHitTestVisible="False" />
            <StackPanel Orientation="Horizontal" Spacing="8"
                        Margin="10,7" VerticalAlignment="Center">
                <Border Background="{DynamicResource AccentSoftFillBrush}"
                        BorderBrush="{DynamicResource AccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPill}"
                        Padding="10,5"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:Lucide Icon="CheckCheck" Width="13" Height="13"
                                       StrokeBrush="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" />
                        <TextBlock Classes="TabularNum"
                                   Text="{Binding AccountsVm.FooterSelectedText}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Width="1" Height="20"
                        Background="{DynamicResource BorderSubtleBrush}"
                        Margin="2,0" VerticalAlignment="Center" />
                <Button Classes="StudioPrimaryBtn"
                        Command="{Binding LaunchBar.JoinServerSelectedCommand}"
                        Padding="13,7"
                        ToolTip.Tip="{DynamicResource Bar_TipJoinServer}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:Lucide Icon="Play" Width="12" Height="12"
                                       StrokeBrush="{DynamicResource AccentForegroundBrush}"
                                       StrokeThickness="2.4" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LaunchBar.JoinServerButtonText}"
                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="StudioSecondaryBtn"
                        Command="{Binding LaunchBar.LaunchSelectedCommand}"
                        Padding="11,7"
                        ToolTip.Tip="{DynamicResource Bar_TipLaunchHome}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:Lucide Icon="House" Width="13" Height="13"
                                       StrokeBrush="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Dash_LaunchHome}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="StudioSecondaryBtn"
                        Padding="11,7"
                        ToolTip.Tip="{DynamicResource Bar_BatchActionsTooltip}">
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedLeft">
                            <MenuItem Header="{DynamicResource Bar_ValidateSelected}"
                                      Command="{Binding AccountsVm.ValidateSessionSelectedCommand}">
                                <MenuItem.Icon>
                                    <lucide:Lucide Icon="ShieldCheck" Width="14" Height="14"
                                                   StrokeBrush="{DynamicResource StatusSuccessBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Bar_ReLoginSelected}"
                                      Command="{Binding AccountsVm.ReLoginSelectedCommand}">
                                <MenuItem.Icon>
                                    <lucide:Lucide Icon="Key" Width="14" Height="14"
                                                   StrokeBrush="{DynamicResource StatusWarningBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Bar_SetGroupSelected}"
                                      Command="{Binding AccountsVm.SetGroupSelectedCommand}">
                                <MenuItem.Icon>
                                    <lucide:Lucide Icon="Folder" Width="14" Height="14"
                                                   StrokeBrush="#A855F7" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Bar_SavePlaceIdSelected}"
                                      Command="{Binding AccountsVm.SavePlaceIdSelectedCommand}">
                                <MenuItem.Icon>
                                    <lucide:Lucide Icon="Bookmark" Width="14" Height="14"
                                                   StrokeBrush="{DynamicResource StatusInfoBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Bar_CopyUserPassSelected}"
                                      Command="{Binding AccountsVm.CopyUserPassSelectedCommand}">
                                <MenuItem.Icon>
                                    <lucide:Lucide Icon="ClipboardCopy" Width="14" Height="14"
                                                   StrokeBrush="{DynamicResource TextSecondaryBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{DynamicResource Tool_RefreshRobux}"
                                      Command="{Binding AccountsVm.RefreshAllRobuxCommand}">
                                <MenuItem.Icon>
                                    <lucide:Lucide Icon="Coins" Width="14" Height="14"
                                                   StrokeBrush="{DynamicResource StatusWarningBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Bar_RemoveSelected}"
                                      Foreground="{DynamicResource StatusDangerBrush}"
                                      Command="{Binding AccountsVm.RemoveSelectedCommand}">
                                <MenuItem.Icon>
                                    <lucide:Lucide Icon="Trash2" Width="14" Height="14"
                                                   StrokeBrush="{DynamicResource StatusDangerBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:Lucide Icon="Zap" Width="13" Height="13"
                                       StrokeBrush="{DynamicResource StatusWarningBrush}"
                                       VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Bar_BatchActions}"
                                   VerticalAlignment="Center" />
                        <lucide:Lucide Icon="ChevronUp" Width="11" Height="11"
                                       StrokeBrush="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="StudioDangerBtn"
                        Command="{Binding AccountsVm.ClearSelectionCommand}"
                        Padding="11,7"
                        ToolTip.Tip="{DynamicResource Bar_ClearSelectionTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <lucide:Lucide Icon="X" Width="13" Height="13"
                                       StrokeBrush="{DynamicResource StatusDangerBrush}"
                                       VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Btn_Deselect}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Panel>
    </Border>
</UserControl>
