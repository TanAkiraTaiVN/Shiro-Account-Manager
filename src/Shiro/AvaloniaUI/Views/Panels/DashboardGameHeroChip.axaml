<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Shiro.AvaloniaUI.Controls"
             xmlns:vm="clr-namespace:Shiro.ViewModels"
             xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             mc:Ignorable="d"
             x:Class="Shiro.AvaloniaUI.Views.Panels.DashboardGameHeroChip"
             x:DataType="vm:LaunchBarViewModel"
             x:CompileBindings="True">
    <controls:SpotlightBorder Background="{DynamicResource SurfaceCardBrush}"
                              BorderBrush="{DynamicResource AccentBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="{StaticResource RadiusMid12}"
                              BoxShadow="{StaticResource ShadowCard}"
                              SpotlightColor="{DynamicResource AccentColor}"
                              SpotlightOpacity="0.10"
                              BorderGlowOpacity="0.34"
                              TopRimEnabled="True"
                              ClipToBounds="True"
                              MaxWidth="226"
                              ToolTip.Tip="{Binding CurrentGameName}">
        <Panel>
            <Border IsHitTestVisible="False"
                    Background="{DynamicResource AccentSoftFillBrush}"
                    Opacity="0.45" />
            <Border IsHitTestVisible="False"
                    Background="{Binding HeroAuraBrush}"
                    IsVisible="{Binding HasAdaptiveGameColor}" />
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,4">
                <Border Grid.Column="0"
                        Width="26"
                        Height="26"
                        CornerRadius="{StaticResource RadiusChip6}"
                        ClipToBounds="True"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource AccentBorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,7,0"
                        VerticalAlignment="Center">
                    <Panel>
                        <lucide:Lucide Icon="Gamepad2"
                                       Width="13"
                                       Height="13"
                                       StrokeBrush="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding CurrentGameThumbnail,
                                           Converter={x:Static ObjectConverters.IsNull}}" />
                        <Image Source="{Binding CurrentGameThumbnail}"
                               Width="26"
                               Height="26"
                               Stretch="UniformToFill"
                               IsVisible="{Binding CurrentGameThumbnail,
                                   Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Panel>
                </Border>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="1"
                            Margin="0,0,7,0">
                    <TextBlock Text="{Binding CurrentGameName}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="94"
                               IsVisible="{Binding CurrentGameName,
                                   Converter={StaticResource StringNotNullOrEmpty}}" />
                    <TextBlock Classes="TabularNum"
                               Text="{Binding CurrentPlaceIdLabel}"
                               FontSize="9.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="94" />
                </StackPanel>
                <Button x:Name="BtnHeroViewServers"
                        Grid.Column="2"
                        Classes="StudioSecondaryBtn"
                        Command="{Binding OpenCurrentGameServersCommand}"
                        Padding="7,4"
                        CornerRadius="{StaticResource RadiusChip6}"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{DynamicResource Dash_HeroViewServersTip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <lucide:Lucide Icon="Globe"
                                       Width="11"
                                       Height="11"
                                       StrokeBrush="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Dash_HeroViewServers}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Panel>
    </controls:SpotlightBorder>
</UserControl>
