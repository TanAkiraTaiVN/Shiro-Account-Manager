<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Shiro.ViewModels"
             xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             mc:Ignorable="d"
             x:Class="Shiro.AvaloniaUI.Views.Panels.ServerListResultsPanel"
             x:DataType="vm:ServerListViewModel"
             x:CompileBindings="True"
             x:Name="RootResultsPanel">
    <Border Background="#111115" BorderBrush="#24242C" BorderThickness="1"
            CornerRadius="8" Padding="12">
        <Panel>
            <Grid IsVisible="{Binding SelectedSubTabIndex, Converter={StaticResource EqualityToBoolean}, ConverterParameter='0'}"
                  RowDefinitions="Auto,*">
                <Border Grid.Row="0" Background="#14141A" BorderBrush="#24242C"
                        BorderThickness="0,0,0,1" CornerRadius="6,6,0,0" Padding="14,6">
                    <Grid ColumnDefinitions="2.5*,1.4*,1.0*,1.6*,120">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Srv_ColJobId}"
                                   FontSize="11" FontWeight="Bold" Foreground="#71717A"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="SortHeaderBtn"
                                Command="{Binding ToggleSortPlayersCommand}"
                                ToolTip.Tip="{DynamicResource Srv_SortPlayersTip}">
                            <StackPanel Orientation="Horizontal" Spacing="5"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Srv_ColPlayers}"
                                           FontSize="11" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PlayersSortHeaderIndicator}"
                                           IsVisible="{Binding HasPlayersSortIndicator}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#38BDF8" VerticalAlignment="Center" />
                                <lucide:Lucide Icon="ArrowUpDown" Width="11" Height="11"
                                               StrokeBrush="#52525B"
                                               IsVisible="{Binding !HasPlayersSortIndicator}"
                                               VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="SortHeaderBtn"
                                Command="{Binding ToggleSortPingCommand}"
                                ToolTip.Tip="{DynamicResource Srv_SortPingTip}">
                            <StackPanel Orientation="Horizontal" Spacing="5"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Srv_ColPing}"
                                           FontSize="11" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PingSortHeaderIndicator}"
                                           IsVisible="{Binding HasPingSortIndicator}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#22C55E" VerticalAlignment="Center" />
                                <lucide:Lucide Icon="ArrowUpDown" Width="11" Height="11"
                                               StrokeBrush="#52525B"
                                               IsVisible="{Binding !HasPingSortIndicator}"
                                               VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="3" Text="{DynamicResource Srv_ColRegion}"
                                   FontSize="11" FontWeight="Bold" Foreground="#71717A"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{DynamicResource Srv_ColActions}"
                                   FontSize="11" FontWeight="Bold" Foreground="#71717A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" IsVisible="{Binding IsServersEmpty}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <lucide:Lucide Icon="Globe" Width="36" Height="36" StrokeBrush="#38BDF8"
                                   HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Srv_EmptyHint}" Foreground="#A1A1AA"
                               FontSize="13" HorizontalAlignment="Center" />
                </StackPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Servers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel CacheLength="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          BringIntoViewOnFocusChange="False" Padding="0,0,12,0">
                                <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerItemViewModel">
                            <Border Height="44" Background="#111116" BorderBrush="#1C1C24"
                                    BorderThickness="0,0,0,1" Padding="14,0" Cursor="Hand">
                                <Grid ColumnDefinitions="2.5*,1.4*,1.0*,1.6*,120">
                                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*"
                                          Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Button Grid.Column="0" Classes="FastIconBtn"
                                                Command="{Binding #RootResultsPanel.((vm:ServerListViewModel)DataContext).CopyJobIdCommand}"
                                                CommandParameter="{Binding}" Width="22" Height="22"
                                                Margin="0,0,6,0"
                                                ToolTip.Tip="{DynamicResource Srv_TipCopyJobId}">
                                            <Path Data="{StaticResource GeoCopy}" Width="12"
                                                  Height="12" Stretch="Uniform" Stroke="#A1A1AA"
                                                  StrokeThickness="1.8" StrokeLineCap="Round"
                                                  StrokeJoin="Round" />
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding JobId}"
                                                   FontSize="11"
                                                   FontFamily="Consolas, Cascadia Code, monospace"
                                                   Foreground="#FFFFFF"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto"
                                          ClipToBounds="True" VerticalAlignment="Center"
                                          Margin="0,0,10,0">
                                        <TextBlock Grid.Column="0" Text="{Binding PlayerDisplay}"
                                                   FontSize="11" Foreground="#FFFFFF" MinWidth="44"
                                                   VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding PlayerPercentage}"
                                                     Maximum="100" Transitions="{x:Null}"
                                                     MinWidth="0" MinHeight="0" Width="55"
                                                     MaxWidth="55" Height="6" CornerRadius="3"
                                                     Foreground="#22C55E" Background="#24242C"
                                                     VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                Spacing="6" VerticalAlignment="Center"
                                                Margin="0,0,8,0">
                                        <Ellipse Width="6" Height="6" Fill="{Binding PingColor}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PingDisplay}" FontSize="11"
                                                   Foreground="{Binding PingColor}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                Spacing="6" VerticalAlignment="Center"
                                                Margin="0,0,8,0">
                                        <Border Width="18" Height="13" CornerRadius="2"
                                                ClipToBounds="True" VerticalAlignment="Center"
                                                IsVisible="{Binding HasFlagImage}">
                                            <Image Source="{Binding FlagImage}" Width="18"
                                                   Height="13" Stretch="Fill" />
                                        </Border>
                                        <TextBlock Text="{Binding RegionText}" FontSize="11"
                                                   Foreground="#A1A1AA" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Classes="FastIconBtn"
                                                Command="{Binding #RootResultsPanel.((vm:ServerListViewModel)DataContext).LoadRegionCommand}"
                                                CommandParameter="{Binding}" Width="20" Height="20"
                                                ToolTip.Tip="{DynamicResource Srv_TipLoadRegion}">
                                            <Path Data="{StaticResource GeoMapPin}" Width="12"
                                                  Height="12" Stretch="Uniform" Stroke="#38BDF8"
                                                  StrokeThickness="1.8" StrokeLineCap="Round"
                                                  StrokeJoin="Round" />
                                        </Button>
                                    </StackPanel>
                                    <Button Grid.Column="4" Classes="FastPillBtn"
                                            Command="{Binding #RootResultsPanel.((vm:ServerListViewModel)DataContext).JoinServerCommand}"
                                            CommandParameter="{Binding}" Background="#22C55E"
                                            Foreground="#09090B" FontWeight="Bold" FontSize="11"
                                            CornerRadius="6" Padding="12,6"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Data="{StaticResource GeoPlay}" Width="9"
                                                  Height="9" Stretch="Uniform" Fill="#09090B"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Srv_JoinServer}"
                                                       Foreground="#09090B"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <Grid IsVisible="{Binding SelectedSubTabIndex, Converter={StaticResource EqualityToBoolean}, ConverterParameter='1'}"
                  RowDefinitions="Auto,*">
                <Border Grid.Row="0" Background="#14141A" BorderBrush="#24242C"
                        BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding GameSearchTerm, Mode=TwoWay}"
                                 Watermark="{DynamicResource Srv_SearchGamePlaceholder}"
                                 Background="#18181F" Foreground="#FFFFFF" BorderBrush="#2E2E38"
                                 CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SearchGamesCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Command="{Binding SearchGamesCommand}"
                                IsEnabled="{Binding !IsSearchingGames}" Background="#FFFFFF"
                                Foreground="#09090B" FontWeight="Bold" CornerRadius="6"
                                Padding="16,8" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <lucide:Lucide Icon="Search" Width="13" Height="13"
                                               StrokeBrush="#09090B" StrokeThickness="2.5"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Srv_SearchGames}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" IsVisible="{Binding IsSearchingGames}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressBar IsIndeterminate="True" Width="150" Height="4"
                                 CornerRadius="2" Foreground="#38BDF8" Background="#24242C"
                                 HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Srv_SearchingGamesHint}"
                               Foreground="#A1A1AA" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1" IsVisible="{Binding IsSearchGamesEmpty}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <lucide:Lucide Icon="Gamepad2" Width="36" Height="36"
                                   StrokeBrush="#52525B" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Srv_NoGamesFound}" Foreground="#A1A1AA"
                               FontSize="13" HorizontalAlignment="Center" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsSearchingGames}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SearchGames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameSearchItemViewModel">
                                <Border Width="280" Height="84" Background="#18181F"
                                        BorderBrush="#24242C" BorderThickness="1"
                                        CornerRadius="8" Margin="6" Padding="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="48" Height="48"
                                                CornerRadius="8" ClipToBounds="True"
                                                Background="#121218" Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <Panel>
                                                <lucide:Lucide Icon="Gamepad2" Width="22"
                                                               Height="22" StrokeBrush="#52525B"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding ThumbnailBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                                                <Image Source="{Binding ThumbnailBitmap}"
                                                       Width="48" Height="48"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding ThumbnailBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    Spacing="2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Normal"
                                                       FontSize="13" Foreground="#FFFFFF"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PlaceId, StringFormat='ID: {0}'}"
                                                       FontSize="11" Foreground="#71717A" />
                                            <TextBlock Text="{Binding PlayerCountDisplay}"
                                                       FontSize="10" Foreground="#22C55E" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4"
                                                    VerticalAlignment="Center">
                                            <Button Content="{DynamicResource Srv_Select}"
                                                    Command="{Binding #RootResultsPanel.((vm:ServerListViewModel)DataContext).SelectGameCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="#22222E" Foreground="#FFFFFF"
                                                    CornerRadius="4" Padding="8,4" FontSize="11"
                                                    Cursor="Hand" />
                                            <Button Command="{Binding #RootResultsPanel.((vm:ServerListViewModel)DataContext).LaunchGameCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="#22C55E" Foreground="#09090B"
                                                    FontWeight="Bold" CornerRadius="4"
                                                    Padding="8,4" FontSize="11" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <lucide:Lucide Icon="Play" Width="10"
                                                                   Height="10"
                                                                   StrokeBrush="#09090B"
                                                                   StrokeThickness="2.5"
                                                                   VerticalAlignment="Center" />
                                                    <TextBlock Text="{DynamicResource Srv_Play}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Panel>
    </Border>
</UserControl>
