<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Shiro.AvaloniaUI.Controls"
             xmlns:vm="clr-namespace:Shiro.ViewModels"
             xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             mc:Ignorable="d" x:Class="Shiro.AvaloniaUI.Views.Panels.ServerListResultsPanel"
             x:DataType="vm:ServerListViewModel" x:CompileBindings="True" x:Name="RootResultsPanel">
    <UserControl.Styles>
        <Style Selector="Border.SkelCard">
            <Setter Property="Width" Value="296" />
            <Setter Property="Height" Value="90" />
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="controls|SpotlightBorder.ExplorerCard">
            <Setter Property="Width" Value="296" />
            <Setter Property="Height" Value="90" />
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
            <Setter Property="BoxShadow" Value="{StaticResource ShadowCard}" />
            <Setter Property="SpotlightColor" Value="{DynamicResource AccentColor}" />
            <Setter Property="SpotlightOpacity" Value="0.05" />
            <Setter Property="BorderGlowOpacity" Value="0.22" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1" CornerRadius="{StaticResource RadiusXl}" BoxShadow="{StaticResource ShadowCard}">
        <Panel>
            <!-- Tab 0: Live Server Table -->
            <Grid IsVisible="{Binding SelectedSubTabIndex, Converter={StaticResource EqualityToBoolean}, ConverterParameter='0'}"
                  RowDefinitions="Auto,*">
                <Border Grid.Row="0" Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0" Padding="16,9">
                    <Grid ColumnDefinitions="2.5*,1.4*,1.0*,1.6*,128">
                        <TextBlock Grid.Column="0" Classes="SectionKicker" Text="{DynamicResource Srv_ColJobId}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="SortHeaderBtn" Command="{Binding BrowserTab.ToggleSortPlayersCommand}"
                                ToolTip.Tip="{DynamicResource Srv_SortPlayersTip}">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Classes="SectionKicker" Text="{DynamicResource Srv_ColPlayers}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding BrowserTab.PlayersSortHeaderIndicator}"
                                           IsVisible="{Binding BrowserTab.HasPlayersSortIndicator}"
                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StatusInfoBrush}" VerticalAlignment="Center" />
                                <lucide:Lucide Icon="ArrowUpDown" Width="11" Height="11" StrokeBrush="{DynamicResource TextMutedBrush}"
                                               IsVisible="{Binding !BrowserTab.HasPlayersSortIndicator}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="SortHeaderBtn" Command="{Binding BrowserTab.ToggleSortPingCommand}"
                                ToolTip.Tip="{DynamicResource Srv_SortPingTip}">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Classes="SectionKicker" Text="{DynamicResource Srv_ColPing}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding BrowserTab.PingSortHeaderIndicator}"
                                           IsVisible="{Binding BrowserTab.HasPingSortIndicator}"
                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StatusSuccessBrush}" VerticalAlignment="Center" />
                                <lucide:Lucide Icon="ArrowUpDown" Width="11" Height="11" StrokeBrush="{DynamicResource TextMutedBrush}"
                                               IsVisible="{Binding !BrowserTab.HasPingSortIndicator}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="3" Classes="SectionKicker" Text="{DynamicResource Srv_ColRegion}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Classes="SectionKicker" Text="{DynamicResource Srv_ColActions}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" IsVisible="{Binding BrowserTab.IsServersEmpty}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="24">
                    <Border Width="64" Height="64" CornerRadius="{StaticResource RadiusPill}"
                            Background="{DynamicResource StatusInfoBgBrush}"
                            BorderBrush="{DynamicResource StatusInfoBorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <lucide:Lucide Icon="Globe" Width="28" Height="28" StrokeBrush="{DynamicResource StatusInfoBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource Srv_EmptyHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Center" />
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding BrowserTab.Servers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel CacheLength="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          BringIntoViewOnFocusChange="False" Padding="0,0,8,0">
                                <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerItemViewModel">
                            <Border Height="46" Background="{DynamicResource SurfacePanelBrush}"
                                    BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="0,0,0,1" Padding="16,0" Cursor="Hand">
                                <Grid ColumnDefinitions="2.5*,1.4*,1.0*,1.6*,128">
                                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Button Grid.Column="0" Classes="FastIconBtn" Transitions="{x:Null}"
                                                Command="{Binding #RootResultsPanel.((vm:ServerListViewModel)DataContext).BrowserTab.CopyJobIdCommand}"
                                                CommandParameter="{Binding}" Width="24" Height="24" Margin="0,0,6,0"
                                                ToolTip.Tip="{DynamicResource Srv_TipCopyJobId}">
                                            <Path Data="{StaticResource GeoCopy}" Width="12" Height="12" Stretch="Uniform"
                                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                                                  StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding ShownJobId}" FontSize="11.5"
                                                   FontFamily="Consolas, Cascadia Code, monospace"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Grid.Column="0" Classes="TabularNum" Text="{Binding PlayerDisplay}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" MinWidth="46" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Value="{Binding PlayerPercentage}" Maximum="100" Transitions="{x:Null}"
                                                     MinWidth="0" MinHeight="0" Width="58" MaxWidth="58" Height="6" CornerRadius="3"
                                                     Foreground="{DynamicResource StatusSuccessBrush}"
                                                     Background="{DynamicResource SurfaceSubtleChipBrush}"
                                                     VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Ellipse Width="6" Height="6" Fill="{Binding PingColor}" VerticalAlignment="Center" />
                                        <TextBlock Classes="TabularNum" Text="{Binding PingDisplay}" FontSize="11.5"
                                                   Foreground="{Binding PingColor}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Border Background="{DynamicResource SurfaceSubtleChipBrush}"
                                                BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusSm}" Padding="6,3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border Width="18" Height="12" CornerRadius="2" ClipToBounds="True"
                                                        VerticalAlignment="Center" IsVisible="{Binding HasFlagImage}">
                                                    <Image Source="{Binding FlagImage}" Width="18" Height="12" Stretch="Fill" />
                                                </Border>
                                                <TextBlock Text="{Binding RegionText}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <Button Classes="FastIconBtn" Transitions="{x:Null}"
                                                Command="{Binding #RootResultsPanel.((vm:ServerListViewModel)DataContext).BrowserTab.LoadRegionCommand}"
                                                CommandParameter="{Binding}" Width="22" Height="22"
                                                ToolTip.Tip="{DynamicResource Srv_TipLoadRegion}">
                                            <Path Data="{StaticResource GeoMapPin}" Width="12" Height="12" Stretch="Uniform"
                                                  Stroke="{DynamicResource StatusInfoBrush}" StrokeThickness="1.8"
                                                  StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Button>
                                    </StackPanel>
                                    <Button Grid.Column="4" Classes="FastPillBtn" Transitions="{x:Null}"
                                            Command="{Binding #RootResultsPanel.((vm:ServerListViewModel)DataContext).BrowserTab.JoinServerCommand}"
                                            CommandParameter="{Binding}" Background="{DynamicResource StatusSuccessBrush}"
                                            Foreground="#09090B" FontWeight="Bold" FontSize="11"
                                            CornerRadius="{StaticResource RadiusSm}" Padding="12,6"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Data="{StaticResource GeoPlay}" Width="9" Height="9" Stretch="Uniform"
                                                  Fill="#09090B" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Srv_JoinServer}" Foreground="#09090B" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Tab 1: Game Explorer -->
            <Grid IsVisible="{Binding SelectedSubTabIndex, Converter={StaticResource EqualityToBoolean}, ConverterParameter='1'}"
                  RowDefinitions="Auto,*" Margin="14">
                <Border Grid.Row="0" Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}" Padding="10" Margin="0,0,0,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding ExplorerTab.GameSearchTerm, Mode=TwoWay}"
                                 PlaceholderText="{DynamicResource Srv_SearchGamePlaceholder}"
                                 Padding="10,8" Margin="0,0,8,0" VerticalContentAlignment="Center">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding ExplorerTab.SearchGamesCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Classes="StudioPrimaryBtn" Command="{Binding ExplorerTab.SearchGamesCommand}"
                                IsEnabled="{Binding !ExplorerTab.IsSearchingGames}" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <lucide:Lucide Icon="Search" Width="13" Height="13"
                                               StrokeBrush="{DynamicResource AccentForegroundBrush}"
                                               StrokeThickness="2.4" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Srv_SearchGames}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ShimmerSkeleton Loading Placeholder Cards -->
                <ScrollViewer Grid.Row="1" IsVisible="{Binding ExplorerTab.IsSearchingGames}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource Srv_SearchingGamesHint}"
                                   Foreground="{DynamicResource StatusInfoBrush}" FontSize="12" FontWeight="SemiBold" />
                        <WrapPanel Orientation="Horizontal">
                            <Border Classes="SkelCard">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <controls:ShimmerSkeleton Width="56" Height="56" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" Margin="0,0,10,0">
                                        <controls:ShimmerSkeleton Height="13" Width="118" CornerRadius="{StaticResource RadiusXs}" HorizontalAlignment="Left" />
                                        <controls:ShimmerSkeleton Height="10" Width="76" CornerRadius="{StaticResource RadiusXs}" HorizontalAlignment="Left" />
                                        <controls:ShimmerSkeleton Height="10" Width="62" CornerRadius="{StaticResource RadiusXs}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                        <controls:ShimmerSkeleton Height="24" Width="56" CornerRadius="{StaticResource RadiusSm}" />
                                        <controls:ShimmerSkeleton Height="24" Width="56" CornerRadius="{StaticResource RadiusSm}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="SkelCard">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <controls:ShimmerSkeleton Width="56" Height="56" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" Margin="0,0,10,0">
                                        <controls:ShimmerSkeleton Height="13" Width="126" CornerRadius="{StaticResource RadiusXs}" HorizontalAlignment="Left" />
                                        <controls:ShimmerSkeleton Height="10" Width="82" CornerRadius="{StaticResource RadiusXs}" HorizontalAlignment="Left" />
                                        <controls:ShimmerSkeleton Height="10" Width="66" CornerRadius="{StaticResource RadiusXs}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                        <controls:ShimmerSkeleton Height="24" Width="56" CornerRadius="{StaticResource RadiusSm}" />
                                        <controls:ShimmerSkeleton Height="24" Width="56" CornerRadius="{StaticResource RadiusSm}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="SkelCard">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <controls:ShimmerSkeleton Width="56" Height="56" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" Margin="0,0,10,0">
                                        <controls:ShimmerSkeleton Height="13" Width="110" CornerRadius="{StaticResource RadiusXs}" HorizontalAlignment="Left" />
                                        <controls:ShimmerSkeleton Height="10" Width="72" CornerRadius="{StaticResource RadiusXs}" HorizontalAlignment="Left" />
                                        <controls:ShimmerSkeleton Height="10" Width="58" CornerRadius="{StaticResource RadiusXs}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                        <controls:ShimmerSkeleton Height="24" Width="56" CornerRadius="{StaticResource RadiusSm}" />
                                        <controls:ShimmerSkeleton Height="24" Width="56" CornerRadius="{StaticResource RadiusSm}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="SkelCard">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <controls:ShimmerSkeleton Width="56" Height="56" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" Margin="0,0,10,0">
                                        <controls:ShimmerSkeleton Height="13" Width="122" CornerRadius="{StaticResource RadiusXs}" HorizontalAlignment="Left" />
                                        <controls:ShimmerSkeleton Height="10" Width="78" CornerRadius="{StaticResource RadiusXs}" HorizontalAlignment="Left" />
                                        <controls:ShimmerSkeleton Height="10" Width="64" CornerRadius="{StaticResource RadiusXs}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                        <controls:ShimmerSkeleton Height="24" Width="56" CornerRadius="{StaticResource RadiusSm}" />
                                        <controls:ShimmerSkeleton Height="24" Width="56" CornerRadius="{StaticResource RadiusSm}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" IsVisible="{Binding ExplorerTab.IsSearchGamesEmpty}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="24">
                    <Border Width="64" Height="64" CornerRadius="{StaticResource RadiusPill}"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <lucide:Lucide Icon="Gamepad2" Width="28" Height="28" StrokeBrush="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource Srv_NoGamesFound}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13" HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" IsVisible="{Binding !ExplorerTab.IsSearchingGames}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ExplorerTab.SearchGames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameSearchItemViewModel">
                                <controls:SpotlightBorder Classes="ExplorerCard">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="{StaticResource RadiusMd}"
                                                ClipToBounds="True" Background="{DynamicResource SurfaceElevatedBrush}"
                                                BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1"
                                                Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Panel>
                                                <lucide:Lucide Icon="Gamepad2" Width="22" Height="22" StrokeBrush="{DynamicResource TextMutedBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               IsVisible="{Binding ThumbnailBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                                                <Image Source="{Binding ThumbnailBitmap}" Width="56" Height="56" Stretch="UniformToFill"
                                                       IsVisible="{Binding ThumbnailBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="TabularNum" Text="{Binding PlaceId, StringFormat='ID: {0}'}"
                                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Classes="TabularNum" Text="{Binding PlayerCountDisplay}"
                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center">
                                            <Button Classes="StudioSecondaryBtn" Content="{DynamicResource Srv_Select}"
                                                    Command="{Binding #RootResultsPanel.((vm:ServerListViewModel)DataContext).ExplorerTab.SelectGameCommand}"
                                                    CommandParameter="{Binding}" Padding="9,4" FontSize="11" />
                                            <Button Classes="StudioPrimaryBtn"
                                                    Command="{Binding #RootResultsPanel.((vm:ServerListViewModel)DataContext).ExplorerTab.LaunchGameCommand}"
                                                    CommandParameter="{Binding}" Padding="9,4" FontSize="11">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <lucide:Lucide Icon="Play" Width="10" Height="10"
                                                                   StrokeBrush="{DynamicResource AccentForegroundBrush}"
                                                                   StrokeThickness="2.4" VerticalAlignment="Center" />
                                                    <TextBlock Text="{DynamicResource Srv_Play}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </controls:SpotlightBorder>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BorderTopRimBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusXl}" />
        </Panel>
    </Border>
</UserControl>
