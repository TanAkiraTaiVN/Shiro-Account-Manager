<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Shiro.ViewModels"
             xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             mc:Ignorable="d"
             x:Class="Shiro.AvaloniaUI.Views.Panels.DashboardFooterBar"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True">
    <StackPanel>
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
            <Border Background="{DynamicResource SurfacePanelBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="3"
                    Margin="0,2,8,2">
                <WrapPanel Orientation="Horizontal">
                    <RadioButton Classes="FilterTabPill" GroupName="FilterTabGroup"
                                 IsChecked="{Binding AccountsVm.IsFilterAll, Mode=TwoWay}">
                        <TextBlock Classes="TabularNum" Text="{Binding AccountsVm.TabAllText}" />
                    </RadioButton>
                    <RadioButton Classes="FilterTabPill" GroupName="FilterTabGroup"
                                 IsChecked="{Binding AccountsVm.IsFilterInGame, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource StatusSuccessBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Classes="TabularNum"
                                       Text="{Binding AccountsVm.TabInGameText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="FilterTabPill" GroupName="FilterTabGroup"
                                 IsChecked="{Binding AccountsVm.IsFilterReady, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource StatusInfoBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Classes="TabularNum"
                                       Text="{Binding AccountsVm.TabReadyText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="FilterTabPill" GroupName="FilterTabGroup"
                                 IsChecked="{Binding AccountsVm.IsFilterExpired, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource StatusDangerBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Classes="TabularNum"
                                       Text="{Binding AccountsVm.TabExpiredText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="FilterTabPill" GroupName="FilterTabGroup"
                                 IsChecked="{Binding AccountsVm.IsFilterBanned, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:Lucide Icon="ShieldAlert" Width="13" Height="13"
                                           StrokeBrush="#FDA4AF" VerticalAlignment="Center" />
                            <TextBlock Classes="TabularNum"
                                       Text="{Binding AccountsVm.TabBannedText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="FilterTabPill" GroupName="FilterTabGroup"
                                 IsChecked="{Binding AccountsVm.IsFilterPinned, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:Lucide Icon="Star" Width="13" Height="13"
                                           StrokeBrush="{DynamicResource StatusWarningBrush}"
                                           VerticalAlignment="Center" />
                            <TextBlock Classes="TabularNum"
                                       Text="{Binding AccountsVm.TabPinnedText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </WrapPanel>
            </Border>

            <Border Background="{DynamicResource SurfacePanelBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="3"
                    Margin="0,2,8,2">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <RadioButton Classes="FilterTabPill" GroupName="ViewModeGroup"
                                 IsChecked="{Binding AccountsVm.IsCardView, Mode=TwoWay}"
                                 ToolTip.Tip="{DynamicResource Tab_ViewCardsTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:Lucide Icon="LayoutGrid" Width="13" Height="13"
                                           StrokeBrush="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Dash_ViewCards}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="FilterTabPill" GroupName="ViewModeGroup"
                                 IsChecked="{Binding AccountsVm.IsCompactView, Mode=TwoWay}"
                                 ToolTip.Tip="{DynamicResource Tab_ViewTableTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:Lucide Icon="Table2" Width="13" Height="13"
                                           StrokeBrush="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Dash_ViewCompact}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfacePanelBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="3"
                    Margin="0,2,8,2">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <RadioButton x:Name="BtnDensityCompact" Classes="FilterTabPill"
                                 GroupName="DensityModeGroup"
                                 IsChecked="{Binding AccountsVm.IsDensityCompact, Mode=TwoWay}"
                                 ToolTip.Tip="{DynamicResource Dash_DensityCompact}">
                        <TextBlock Text="{DynamicResource Dash_DensityCompact}"
                                   VerticalAlignment="Center" />
                    </RadioButton>
                    <RadioButton x:Name="BtnDensityBalanced" Classes="FilterTabPill"
                                 GroupName="DensityModeGroup"
                                 IsChecked="{Binding AccountsVm.IsDensityBalanced, Mode=TwoWay}"
                                 ToolTip.Tip="{DynamicResource Dash_DensityBalanced}">
                        <TextBlock Text="{DynamicResource Dash_DensityBalanced}"
                                   VerticalAlignment="Center" />
                    </RadioButton>
                    <RadioButton x:Name="BtnDensityComfortable" Classes="FilterTabPill"
                                 GroupName="DensityModeGroup"
                                 IsChecked="{Binding AccountsVm.IsDensityComfortable, Mode=TwoWay}"
                                 ToolTip.Tip="{DynamicResource Dash_DensityComfortable}">
                        <TextBlock Text="{DynamicResource Dash_DensityComfortable}"
                                   VerticalAlignment="Center" />
                    </RadioButton>
                </StackPanel>
            </Border>

            <Button Classes="StudioSecondaryBtn"
                    Command="{Binding AccountsVm.CheckSessionsCommand}"
                    Padding="12,7"
                    Margin="0,2,0,2"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{DynamicResource Tab_TipScanExpired}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:Lucide Icon="Search" Width="13" Height="13"
                                   StrokeBrush="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Dash_ScanExpired}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <Border IsVisible="{Binding LaunchBar.IsBatchLaunching}"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderHoverBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusLg}"
                Margin="0,0,0,12"
                BoxShadow="{StaticResource ShadowCard}">
            <Panel>
                <Border BorderBrush="{DynamicResource BorderTopRimBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="9"
                        IsHitTestVisible="False" />
                <Grid ColumnDefinitions="*,14,Auto" Margin="14,10">
                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0"
                                    Background="{DynamicResource StatusInfoBgBrush}"
                                    BorderBrush="{DynamicResource StatusInfoBorderBrush}"
                                    BorderThickness="1"
                                    Width="22" Height="22"
                                    CornerRadius="{StaticResource RadiusXs}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <lucide:Lucide Icon="Rocket" Width="12" Height="12"
                                               StrokeBrush="{DynamicResource StatusInfoBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LaunchBar.BatchLaunchTitleText}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding LaunchBar.BatchLaunchDetailText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="12,0,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="420"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Value="{Binding LaunchBar.BatchLaunchProgressPercent}"
                                     Maximum="100"
                                     MinWidth="0" MinHeight="0" Height="4"
                                     CornerRadius="2"
                                     Foreground="{DynamicResource StatusInfoBrush}"
                                     Background="{DynamicResource SurfaceInputBrush}"
                                     Transitions="{x:Null}" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="StudioDangerBtn"
                            Command="{Binding LaunchBar.CancelBatchLaunchCommand}"
                            FontSize="11"
                            Padding="11,6"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{DynamicResource Batch_StopQueueTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:Lucide Icon="Square" Width="10" Height="10"
                                           StrokeBrush="{DynamicResource StatusDangerBrush}"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Batch_StopQueue}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Panel>
        </Border>
    </StackPanel>
</UserControl>
