<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Shiro.ViewModels"
             xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             mc:Ignorable="d"
             x:Class="Shiro.AvaloniaUI.Views.Panels.SchedulerHistoryPanel"
             x:DataType="vm:SchedulerViewModel"
             x:CompileBindings="True"
             IsVisible="{Binding IsHistoryOpen}"
             IsHitTestVisible="{Binding IsHistoryOpen}">
    <Border x:Name="HistoryCardHost"
            Background="{DynamicResource SurfacePanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMid12}"
            BoxShadow="{StaticResource ShadowCard}"
            Padding="14,10">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <lucide:Lucide Grid.Column="0" Icon="Clock" Width="13" Height="13"
                               StrokeBrush="{DynamicResource AccentBrush}"
                               Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="SectionKicker"
                           Text="{DynamicResource Sched_History_Title}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="StudioGhostBtn"
                        Command="{Binding ClearHistoryCommand}"
                        IsEnabled="{Binding HasHistoryEntries}"
                        Padding="8,4" FontSize="11" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <lucide:Lucide Icon="Trash" Width="12" Height="12"
                                       StrokeBrush="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Sched_History_ClearBtn}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Classes="StudioIconBtn"
                        Width="24" Height="24"
                        Command="{Binding ToggleHistoryCommand}"
                        ToolTip.Tip="{DynamicResource Sched_History_CloseTip}">
                    <lucide:Lucide Icon="X" Width="12" Height="12"
                                   StrokeBrush="{DynamicResource TextMutedBrush}" />
                </Button>
            </Grid>

            <TextBlock Text="{DynamicResource Sched_History_EmptyHint}"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextMutedBrush}"
                       IsVisible="{Binding !HasHistoryEntries}"
                       Margin="0,4" />

            <ScrollViewer MaxHeight="200"
                          IsVisible="{Binding HasHistoryEntries}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HistoryItemsControl"
                              ItemsSource="{Binding HistoryEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScheduleHistoryItemViewModel">
                            <Border Background="{DynamicResource SurfaceCardBrush}"
                                    BorderBrush="{DynamicResource BorderHairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusInner8}"
                                    Padding="10,7" Margin="0,2">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                                    <TextBlock Grid.Column="0" Classes="TabularNum"
                                               Text="{Binding TimestampText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ScheduleName}"
                                               FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               MaxWidth="170" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource SurfaceSubtleChipBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusChip6}"
                                            Padding="6,2" Margin="0,0,6,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PhaseBadgeText}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <Border Grid.Column="3"
                                            Background="{Binding OutcomeBackground}"
                                            BorderBrush="{Binding OutcomeBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusChip6}"
                                            Padding="6,2" Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OutcomeBadgeText}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{Binding OutcomeForeground}" />
                                    </Border>
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding SummaryText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
