<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Shiro.AvaloniaUI.Controls"
             xmlns:vm="clr-namespace:Shiro.ViewModels"
             xmlns:services="clr-namespace:Shiro.Services"
             xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             mc:Ignorable="d"
             x:Class="Shiro.AvaloniaUI.Views.Panels.MainWindowOverlaysPanel"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True">
    <UserControl.Styles>
        <Style Selector="Border.ToastCard">
            <Style.Animations>
                <Animation Duration="0:0:0.26" IterationCount="1" FillMode="Forward">
                    <Animation.Easing>
                        <ExponentialEaseOut />
                    </Animation.Easing>
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="18" />
                        <Setter Property="TranslateTransform.Y" Value="6" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.96" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.96" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Button.ToastCloseBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_ToastCloseBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.ToastCloseBtn:pointerover /template/ Border#PART_ToastCloseBorder">
            <Setter Property="Background" Value="#1CFFFFFF" />
        </Style>
        <Style Selector="Button.ToastCloseBtn:pressed /template/ Border#PART_ToastCloseBorder">
            <Setter Property="Background" Value="#2CFFFFFF" />
        </Style>
    </UserControl.Styles>
    <Panel>
        <!-- Bottom Studio Status Strip -->
        <Border VerticalAlignment="Bottom"
                Background="{DynamicResource SurfaceChromeBrush}"
                BorderBrush="{DynamicResource BorderHairlineBrush}"
                BorderThickness="0,1,0,0"
                Height="30"
                Padding="14,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <Grid Grid.Column="0"
                      ColumnDefinitions="Auto,Auto,Auto,Auto,*"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0"
                      ClipToBounds="True">
                    <controls:StatusPulseDot Grid.Column="0"
                                             DotBrush="{DynamicResource StatusSuccessBrush}"
                                             DotSize="5.5"
                                             Width="14"
                                             Height="14"
                                             IsPulsing="{Binding ToolsStatus.HasRunningRobloxProcesses}"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ToolsStatus.FooterReadyStatusText}"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="•"
                               FontSize="11"
                               Foreground="{DynamicResource BorderStrongBrush}"
                               Margin="8,0"
                               VerticalAlignment="Center" />
                    <lucide:Lucide Grid.Column="3"
                                   Icon="Info"
                                   Width="12"
                                   Height="12"
                                   StrokeBrush="{DynamicResource StatusInfoBrush}"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding ToolsStatus.StatusMessage}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ToolsStatus.StatusMessage}" />
                </Grid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="5"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            IsVisible="{Binding ToolsStatus.HasActiveTools}">
                    <Button Classes="FooterToolChip"
                            IsVisible="{Binding ToolsStatus.IsAntiAfk}"
                            Command="{Binding ToolsStatus.ToggleAntiAfkCommand}"
                            ToolTip.Tip="{DynamicResource Tool_AntiAfk}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="5" Height="5"
                                     Fill="{DynamicResource StatusSuccessBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Footer_ChipAntiAfk}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="FooterToolChip"
                            IsVisible="{Binding ToolsStatus.IsPotatoMode}"
                            Command="{Binding ToolsStatus.TogglePotatoModeCommand}"
                            ToolTip.Tip="{DynamicResource Tool_Potato}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="5" Height="5"
                                     Fill="{DynamicResource StatusWarningBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Footer_ChipPotato}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="FooterToolChip"
                            IsVisible="{Binding ToolsStatus.AreWindowsHidden}"
                            Command="{Binding ToolsStatus.ToggleWindowsCommand}"
                            ToolTip.Tip="{DynamicResource Tool_ZeroGpu}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="5" Height="5"
                                     Fill="{DynamicResource StatusInfoBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Footer_ChipZeroGpu}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="FooterToolChip"
                            IsVisible="{Binding ToolsStatus.IsSmartMuteActive}"
                            Command="{Binding ToolsStatus.ToggleSmartMuteCommand}"
                            ToolTip.Tip="{DynamicResource Tool_SmartMute}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="5" Height="5"
                                     Fill="{DynamicResource StatusInfoBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Footer_ChipSmartMute}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="FooterToolChip"
                            IsVisible="{Binding ToolsStatus.IsStreamerModeActive}"
                            Command="{Binding ToolsStatus.ToggleStreamerModeCommand}"
                            ToolTip.Tip="{DynamicResource Tool_StreamerMode}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="5" Height="5" Fill="#A855F7"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Footer_ChipStreamer}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Classes="TabularNum"
                               Text="{Binding AccountsVm.FooterSelectedText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="•"
                               FontSize="11"
                               Foreground="{DynamicResource BorderStrongBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Classes="TabularNum"
                               Text="{Binding AccountsVm.FooterTotalText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Elevated Obsidian Glass Toast Stack -->
        <ItemsControl x:Name="ToastItemsControl"
                      ItemsSource="{x:Static services:ToastService.ActiveToasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,20,40"
                      Width="372">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="services:ToastItem">
                    <Border Classes="ToastCard"
                            Background="{Binding BackgroundBrush}"
                            BorderBrush="{Binding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Margin="0,10,0,0"
                            BoxShadow="{StaticResource ShadowModal}"
                            ClipToBounds="True">
                        <Panel>
                            <Border Background="{Binding AuraBrush}"
                                    IsHitTestVisible="False" />
                            <Border Height="1"
                                    VerticalAlignment="Top"
                                    Margin="18,0,18,0"
                                    Background="{Binding TopSpecularBrush}"
                                    IsHitTestVisible="False" />
                            <Grid RowDefinitions="*,Auto">
                                <Grid Grid.Row="0"
                                      Margin="14,12,12,11"
                                      RowDefinitions="Auto,Auto,Auto"
                                      ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Row="0"
                                            Grid.Column="0"
                                            Width="24" Height="24"
                                            CornerRadius="12"
                                            Background="{Binding BadgeBackground}"
                                            BorderBrush="{Binding BadgeBorderBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0">
                                        <Path Data="{Binding IconGeometry}"
                                              Width="12" Height="12"
                                              Stretch="Uniform"
                                              Stroke="{Binding AccentBrush}"
                                              StrokeThickness="2.1"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{Binding Title}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               LineHeight="17" />
                                    <Button Grid.Row="0"
                                            Grid.Column="2"
                                            Classes="ToastCloseBtn"
                                            Command="{Binding DismissCommand}"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{DynamicResource Btn_Close}">
                                        <Path Data="{StaticResource GeoClose}"
                                              Width="9" Height="9"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource TextMutedBrush}"
                                              StrokeThickness="1.9"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round" />
                                    </Button>
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Message}"
                                               IsVisible="{Binding HasMessage}"
                                               Margin="0,5,6,0"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               MaxLines="6"
                                               LineHeight="17" />
                                    <Button Grid.Row="2"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Classes="StudioSecondaryBtn"
                                            Content="{Binding ActionText}"
                                            Command="{Binding ActionCommand}"
                                            IsVisible="{Binding HasAction}"
                                            CornerRadius="8"
                                            Margin="0,8,0,0"
                                            Padding="10,4"
                                            FontSize="11"
                                            HorizontalAlignment="Left" />
                                </Grid>
                                <Border Grid.Row="1"
                                        Height="2"
                                        CornerRadius="1"
                                        Margin="14,0,14,8"
                                        Background="#14FFFFFF"
                                        ClipToBounds="True"
                                        IsVisible="{Binding HasAutoDismiss}"
                                        IsHitTestVisible="False">
                                    <controls:ToastCountdownBar Height="2"
                                                                CornerRadius="1"
                                                                Background="{Binding ProgressBrush}"
                                                                DurationSeconds="{Binding DurationSeconds}"
                                                                TimerGeneration="{Binding TimerGeneration}" />
                                </Border>
                            </Grid>
                        </Panel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Panel>
</UserControl>
