<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Shiro.AvaloniaUI.Controls"
             xmlns:vm="clr-namespace:Shiro.ViewModels"
             xmlns:services="clr-namespace:Shiro.Services"
             xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             mc:Ignorable="d"
             x:Class="Shiro.AvaloniaUI.Views.Panels.MainWindowOverlaysPanel"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True">
    <UserControl.Styles>
        <Style Selector="Border.ToastCard">
            <Style.Animations>
                <Animation Duration="0:0:0.18" IterationCount="1" FillMode="Forward">
                    <Animation.Easing>
                        <CubicEaseOut />
                    </Animation.Easing>
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="8" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
    <Panel>
        <!-- Bottom Studio Status Strip -->
        <Border VerticalAlignment="Bottom"
                Background="{DynamicResource SurfaceChromeBrush}"
                BorderBrush="{DynamicResource BorderHairlineBrush}"
                BorderThickness="0,1,0,0"
                Height="30"
                Padding="14,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <Grid Grid.Column="0"
                      ColumnDefinitions="Auto,Auto,Auto,Auto,*"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0"
                      ClipToBounds="True">
                    <controls:StatusPulseDot Grid.Column="0"
                                             DotBrush="{DynamicResource StatusSuccessBrush}"
                                             DotSize="5.5"
                                             Width="14"
                                             Height="14"
                                             IsPulsing="{Binding ToolsStatus.HasRunningRobloxProcesses}"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ToolsStatus.FooterReadyStatusText}"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="•"
                               FontSize="11"
                               Foreground="{DynamicResource BorderStrongBrush}"
                               Margin="8,0"
                               VerticalAlignment="Center" />
                    <lucide:Lucide Grid.Column="3"
                                   Icon="Info"
                                   Width="12"
                                   Height="12"
                                   StrokeBrush="{DynamicResource StatusInfoBrush}"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding ToolsStatus.StatusMessage}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ToolsStatus.StatusMessage}" />
                </Grid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="5"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            IsVisible="{Binding ToolsStatus.HasActiveTools}">
                    <Button Classes="FooterToolChip"
                            IsVisible="{Binding ToolsStatus.IsAntiAfk}"
                            Command="{Binding ToolsStatus.ToggleAntiAfkCommand}"
                            ToolTip.Tip="{DynamicResource Tool_AntiAfk}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="5" Height="5"
                                     Fill="{DynamicResource StatusSuccessBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Footer_ChipAntiAfk}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="FooterToolChip"
                            IsVisible="{Binding ToolsStatus.IsPotatoMode}"
                            Command="{Binding ToolsStatus.TogglePotatoModeCommand}"
                            ToolTip.Tip="{DynamicResource Tool_Potato}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="5" Height="5"
                                     Fill="{DynamicResource StatusWarningBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Footer_ChipPotato}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="FooterToolChip"
                            IsVisible="{Binding ToolsStatus.AreWindowsHidden}"
                            Command="{Binding ToolsStatus.ToggleWindowsCommand}"
                            ToolTip.Tip="{DynamicResource Tool_ZeroGpu}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="5" Height="5"
                                     Fill="{DynamicResource StatusInfoBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Footer_ChipZeroGpu}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="FooterToolChip"
                            IsVisible="{Binding ToolsStatus.IsSmartMuteActive}"
                            Command="{Binding ToolsStatus.ToggleSmartMuteCommand}"
                            ToolTip.Tip="{DynamicResource Tool_SmartMute}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="5" Height="5"
                                     Fill="{DynamicResource StatusInfoBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Footer_ChipSmartMute}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="FooterToolChip"
                            IsVisible="{Binding ToolsStatus.IsStreamerModeActive}"
                            Command="{Binding ToolsStatus.ToggleStreamerModeCommand}"
                            ToolTip.Tip="{DynamicResource Tool_StreamerMode}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="5" Height="5" Fill="#A855F7"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Footer_ChipStreamer}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Classes="TabularNum"
                               Text="{Binding AccountsVm.FooterSelectedText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="•"
                               FontSize="11"
                               Foreground="{DynamicResource BorderStrongBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Classes="TabularNum"
                               Text="{Binding AccountsVm.FooterTotalText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Elevated Toast Notification Stack -->
        <ItemsControl x:Name="ToastItemsControl"
                      ItemsSource="{x:Static services:ToastService.ActiveToasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,18,38"
                      Width="332">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="services:ToastItem">
                    <Border Classes="ToastCard"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{Binding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLg}"
                            Margin="0,8,0,0"
                            BoxShadow="{StaticResource ShadowFloating}"
                            ClipToBounds="True">
                        <Border.RenderTransform>
                            <TranslateTransform />
                        </Border.RenderTransform>
                        <Panel>
                            <Border BorderBrush="{DynamicResource BorderTopRimBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusLg}"
                                    IsHitTestVisible="False" />
                            <Grid ColumnDefinitions="3,*">
                                <Border Grid.Column="0"
                                        Background="{Binding AccentBrush}"
                                        VerticalAlignment="Stretch" />
                                <Grid Grid.Column="1"
                                      Margin="12,10,10,10"
                                      ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0"
                                            Width="26" Height="26"
                                            CornerRadius="7"
                                            Background="{Binding BadgeBackground}"
                                            VerticalAlignment="Top"
                                            Margin="0,1,10,0">
                                        <Path Data="{Binding IconGeometry}"
                                              Width="13" Height="13"
                                              Stretch="Uniform"
                                              Stroke="{Binding AccentBrush}"
                                              StrokeThickness="2"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Spacing="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"
                                                   LineHeight="16" />
                                        <TextBlock Text="{Binding Message}"
                                                   IsVisible="{Binding HasMessage}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="6"
                                                   LineHeight="15" />
                                        <Button Classes="StudioSecondaryBtn"
                                                Content="{Binding ActionText}"
                                                Command="{Binding ActionCommand}"
                                                IsVisible="{Binding HasAction}"
                                                Margin="0,6,0,0"
                                                Padding="10,4"
                                                FontSize="11"
                                                HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Classes="FastIconBtn"
                                            Command="{Binding DismissCommand}"
                                            Width="22" Height="22"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Top"
                                            ToolTip.Tip="{DynamicResource Btn_Close}">
                                        <Path Data="{StaticResource GeoClose}"
                                              Width="10" Height="10"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource TextMutedBrush}"
                                              StrokeThickness="1.8"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Panel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Panel>
</UserControl>
