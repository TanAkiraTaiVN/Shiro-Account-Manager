<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             mc:Ignorable="d"
             x:Class="Shiro.AvaloniaUI.Views.AboutView">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
        <Border Width="480" Background="#111115" BorderBrush="#24242C" BorderThickness="1" CornerRadius="12" Padding="32">
            <StackPanel HorizontalAlignment="Center" Spacing="16">
                <!-- Logo Badge -->
                <Border Width="64" Height="64" CornerRadius="16" ClipToBounds="True" HorizontalAlignment="Center">
                    <Image Source="/Resources/shiro_logo.png" Width="64" Height="64" Stretch="UniformToFill" />
                </Border>

                <!-- Titles -->
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="Shiro Account Manager" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource About_Subtitle}" FontSize="12" Foreground="#A1A1AA" HorizontalAlignment="Center" />
                    <Border Background="#1CFFFFFF" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <TextBlock Text="v5.0.0 • Avalonia UI 11 • .NET 10 (win-x64)" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    </Border>
                </StackPanel>

                <Separator Background="#24242C" Height="1" />

                <!-- Technology Specs -->
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <lucide:Lucide Icon="Zap" Width="13" Height="13" StrokeBrush="#A1A1AA" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource About_Runtime}" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <lucide:Lucide Icon="Lock" Width="13" Height="13" StrokeBrush="#A1A1AA" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource About_OptimizationValue}" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <lucide:Lucide Icon="Globe" Width="13" Height="13" StrokeBrush="#A1A1AA" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource About_Credits}" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <Separator Background="#24242C" Height="1" />

                <!-- Copyright -->
                <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource About_Project}" FontSize="10" Foreground="#63636E" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource About_LicenseCredits}" FontSize="9.5" Foreground="#52525B" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
