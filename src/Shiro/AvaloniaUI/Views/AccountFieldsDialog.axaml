<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Shiro.AvaloniaUI.Views"
        xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        x:Class="Shiro.AvaloniaUI.Views.AccountFieldsDialog"
        x:CompileBindings="True"
        Icon="/Resources/shiro.ico"
        Title="{DynamicResource Loc_AccountFields_WindowTitle}"
        Width="520" Height="490"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceChromeBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TransparencyLevelHint="Mica, AcrylicBlur">

    <Border Background="{DynamicResource SurfacePanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusOuter16}"
            BoxShadow="{StaticResource ShadowModal}"
            Margin="10">
        <Panel>
            <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="18">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center" Margin="0,0,0,14">
                    <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusInner8}"
                            Background="{DynamicResource StatusInfoBgBrush}"
                            BorderBrush="{DynamicResource StatusInfoBorderBrush}" BorderThickness="1">
                        <lucide:Lucide Icon="Database" Width="16" Height="16"
                                       StrokeBrush="{DynamicResource StatusInfoBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TxtHeaderTitle"
                               Text="{DynamicResource Loc_AccountFields_DefaultHeader}"
                               FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <Border Grid.Row="1" Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMid12}" Padding="6" Margin="0,0,0,12">
                    <ListBox x:Name="FieldsListBox" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="views:AccountFieldItem">
                                <Grid ColumnDefinitions="*,*,Auto" Margin="6,4">
                                    <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Classes="StudioDangerBtn"
                                            CornerRadius="{StaticResource RadiusChip6}"
                                            Click="BtnDeleteField_Click"
                                            FontSize="11" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Path Data="{StaticResource GeoTrash}" Width="11" Height="11"
                                                  Stretch="Uniform" Stroke="{DynamicResource StatusDangerBrush}"
                                                  StrokeThickness="1.8" StrokeLineCap="Round"
                                                  StrokeJoin="Round" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Loc_Btn_Delete}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Grid Grid.Row="2" ColumnDefinitions="*,*,Auto" Margin="0,0,0,14">
                    <TextBox x:Name="TxtNewKey"
                             PlaceholderText="{DynamicResource Loc_AccountFields_KeyWatermark}"
                             CornerRadius="{StaticResource RadiusInner8}"
                             Margin="0,0,8,0" Padding="10,7" FontSize="12" />
                    <TextBox Grid.Column="1" x:Name="TxtNewValue"
                             PlaceholderText="{DynamicResource Loc_AccountFields_ValueWatermark}"
                             CornerRadius="{StaticResource RadiusInner8}"
                             Margin="0,0,8,0" Padding="10,7" FontSize="12" />
                    <Button Grid.Column="2" Classes="StudioPrimaryBtn"
                            CornerRadius="{StaticResource RadiusChip6}"
                            Click="BtnAddField_Click"
                            Padding="14,7" FontSize="12">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <lucide:Lucide Icon="Plus" Width="13" Height="13"
                                           StrokeBrush="{DynamicResource AccentForegroundBrush}"
                                           StrokeThickness="2.4" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Loc_Btn_Add}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="StudioSecondaryBtn" Height="32" Padding="14,0"
                            CornerRadius="{StaticResource RadiusChip6}"
                            Click="BtnClose_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:Lucide Icon="X" Width="13" Height="13"
                                           StrokeBrush="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Loc_Btn_Close}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Border IsHitTestVisible="False"
                    BorderBrush="{DynamicResource BorderTopRimBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusOuter16}" />
        </Panel>
    </Border>
</Window>
