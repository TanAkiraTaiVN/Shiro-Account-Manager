<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Shiro.AvaloniaUI.Controls"
        xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        xmlns:dlg="clr-namespace:Shiro.ViewModels.Dialogs"
        x:Class="Shiro.AvaloniaUI.Views.AccountUtilsDialog"
        x:DataType="dlg:AccountUtilsViewModel"
        x:CompileBindings="True"
        Icon="/Resources/shiro.ico"
        Title="{DynamicResource Loc_AccountUtils_WindowTitle}"
        Width="496" SizeToContent="Height"
        MinWidth="400" MaxWidth="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource SurfaceChromeBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TransparencyLevelHint="Mica, AcrylicBlur">

    <Border Background="{DynamicResource SurfacePanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusOuter16}"
            BoxShadow="{StaticResource ShadowModal}"
            Margin="10">
        <Panel>
            <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center" Margin="0,0,0,16">
                    <Border Width="38" Height="38" CornerRadius="{StaticResource RadiusInner8}"
                            Background="{DynamicResource StatusInfoBgBrush}"
                            BorderBrush="{DynamicResource StatusInfoBorderBrush}" BorderThickness="1">
                        <lucide:Lucide Icon="Wrench" Width="17" Height="17"
                                       StrokeBrush="{DynamicResource StatusInfoBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTitle" Text="{Binding Title}" FontSize="16"
                                   FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="TxtDisplayName" Text="{Binding DisplayName}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,14">
                    <controls:SpotlightBorder Background="{DynamicResource SurfaceCardBrush}"
                                              BorderBrush="{DynamicResource BorderSubtleBrush}"
                                              BorderThickness="1"
                                              CornerRadius="{StaticResource RadiusMid12}"
                                              BoxShadow="{StaticResource ShadowCard}"
                                              SpotlightColor="{DynamicResource AccentColor}"
                                              SpotlightOpacity="0.04"
                                              BorderGlowOpacity="0.18"
                                              Padding="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Loc_AccountUtils_LogoutOtherHeading}"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{DynamicResource Loc_AccountUtils_LogoutOtherDesc}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="StudioSecondaryBtn"
                                    CornerRadius="{StaticResource RadiusChip6}"
                                    Command="{Binding LogOutOtherSessionsCommand}"
                                    Padding="12,7" FontSize="12" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <lucide:Lucide Icon="LogOut" Width="13" Height="13"
                                                   StrokeBrush="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Loc_AccountUtils_ExecuteBtn}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </controls:SpotlightBorder>

                    <controls:SpotlightBorder Background="{DynamicResource SurfaceCardBrush}"
                                              BorderBrush="{DynamicResource BorderSubtleBrush}"
                                              BorderThickness="1"
                                              CornerRadius="{StaticResource RadiusMid12}"
                                              BoxShadow="{StaticResource ShadowCard}"
                                              SpotlightColor="{DynamicResource AccentColor}"
                                              SpotlightOpacity="0.04"
                                              BorderGlowOpacity="0.18"
                                              Padding="14">
                        <Grid RowDefinitions="Auto,Auto">
                            <StackPanel Spacing="2" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Loc_AccountUtils_PasswordHeading}"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{DynamicResource Loc_AccountUtils_PasswordDesc}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                <TextBox x:Name="TxtPassword" Text="{Binding Password, Mode=TwoWay}"
                                         PlaceholderText="{DynamicResource Loc_AccountUtils_PasswordWatermark}"
                                         CornerRadius="{StaticResource RadiusInner8}"
                                         PasswordChar="•" Padding="10,7" FontSize="13" Margin="0,0,8,0" />
                                <Button Grid.Column="1" Classes="StudioPrimaryBtn"
                                        CornerRadius="{StaticResource RadiusChip6}"
                                        Command="{Binding SavePasswordCommand}"
                                        Padding="14,7" FontSize="12">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <lucide:Lucide Icon="Save" Width="13" Height="13"
                                                       StrokeBrush="{DynamicResource AccentForegroundBrush}"
                                                       StrokeThickness="2.2" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Loc_AccountUtils_SavePasswordBtn}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </controls:SpotlightBorder>
                </StackPanel>

                <TextBlock x:Name="TxtStatus" Grid.Row="2" Text="{Binding StatusText}"
                           Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}"
                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Classes="StudioSecondaryBtn" Height="32" Padding="14,0"
                            CornerRadius="{StaticResource RadiusChip6}"
                            Command="{Binding CloseCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:Lucide Icon="X" Width="13" Height="13"
                                           StrokeBrush="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Loc_Btn_Close}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Border IsHitTestVisible="False"
                    BorderBrush="{DynamicResource BorderTopRimBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusOuter16}" />
        </Panel>
    </Border>
</Window>
