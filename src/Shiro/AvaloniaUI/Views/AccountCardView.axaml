<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Shiro.AvaloniaUI.Controls"
             xmlns:vm="clr-namespace:Shiro.ViewModels"
             x:Class="Shiro.AvaloniaUI.Views.AccountCardView"
             x:DataType="vm:AccountViewModel"
             x:CompileBindings="True">

    <Border x:Name="CardRoot"
            Height="138"
            Background="{DynamicResource SurfaceCardGradientBrush}"
            BorderBrush="{Binding CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="5,0,5,12"
            Padding="0"
            ClipToBounds="True"
            VerticalAlignment="Top"
            Cursor="Hand"
            PointerPressed="OnRootPointerPressed"
            DoubleTapped="OnRootDoubleTapped">
        <Panel>
            <Border IsVisible="{Binding IsSelected}"
                    Background="{DynamicResource AccentSoftFillBrush}"
                    IsHitTestVisible="False" />
            <Border BorderBrush="{DynamicResource BorderTopRimBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="9"
                    IsHitTestVisible="False" />
            <Border x:Name="KeyboardFocusRing"
                    Classes="CardFocusRing" />

            <Grid x:Name="CardContentGrid" RowDefinitions="Auto,*" Margin="10,10">
                <!-- Card Top Row -->
                <Grid x:Name="CardTopRow" Grid.Row="0" ColumnDefinitions="*,4,Auto" Margin="0,0,0,9">
                    <Grid Grid.Column="0" ColumnDefinitions="*,Auto,Auto"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          ClipToBounds="True">
                        <Border Grid.Column="0"
                                Background="{DynamicResource SurfaceSubtleChipBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="5" Padding="5,2"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding GroupTooltip}">
                            <TextBlock Text="{Binding GroupDisplay}"
                                       FontSize="10.5" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Button x:Name="BtnDelete" Grid.Column="1"
                                Classes="FastIconBtn" Width="18" Height="18"
                                Margin="2,0,0,0" Click="OnDeleteClicked"
                                ToolTip.Tip="{DynamicResource Card_TipDelete}">
                            <Path Data="{StaticResource GeoTrash}"
                                  Width="10.5" Height="10.5" Stretch="Uniform"
                                  Stroke="{DynamicResource TextMutedBrush}"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Button>
                        <Button x:Name="BtnOpenProfile" Grid.Column="2"
                                Classes="FastIconBtn" Width="18" Height="18"
                                Margin="1,0,0,0" Click="OnOpenProfileClicked"
                                ToolTip.Tip="{DynamicResource Card_TipProfile}">
                            <Path Data="{StaticResource GeoExternalLink}"
                                  Width="10.5" Height="10.5" Stretch="Uniform"
                                  Stroke="{DynamicResource TextMutedBrush}"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Button>
                    </Grid>

                    <StackPanel x:Name="StatusCluster" Grid.Column="2"
                                Orientation="Horizontal" Spacing="4"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{Binding StatusBadgeBackground}"
                                BorderBrush="{Binding StatusBadgeBorder}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="5,2" VerticalAlignment="Center"
                                ToolTip.Tip="{Binding StatusTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <controls:StatusPulseDot
                                    DotBrush="{Binding StatusBadgeForeground}"
                                    DotSize="6" IsPulsing="{Binding IsInGame}"
                                    VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{Binding StatusBadgeForeground}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="96" />
                            </StackPanel>
                        </Border>

                        <Button Classes="FastPillBtn"
                                IsVisible="{Binding ShowPlayButton}"
                                Click="OnLaunchOrReloginClicked"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource AccentForegroundBrush}"
                                FontWeight="Bold" FontSize="11"
                                CornerRadius="6" Padding="8,4"
                                ToolTip.Tip="{DynamicResource Card_TipLaunch}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Path Data="{StaticResource GeoPlay}"
                                      Width="9" Height="9" Stretch="Uniform"
                                      Fill="{DynamicResource AccentForegroundBrush}"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LaunchButtonText}"
                                           Foreground="{DynamicResource AccentForegroundBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" Spacing="4"
                                    IsVisible="{Binding ShowRunningClientControls}">
                            <Button Classes="FastPillBtn"
                                    Click="OnFocusWindowClicked"
                                    Background="{DynamicResource StatusSuccessBgBrush}"
                                    Foreground="{DynamicResource StatusSuccessBrush}"
                                    BorderBrush="{DynamicResource StatusSuccessBorderBrush}"
                                    BorderThickness="1" FontWeight="Bold" FontSize="11"
                                    CornerRadius="6" Padding="7,4"
                                    ToolTip.Tip="{DynamicResource Card_TipFocusWindow}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Data="{StaticResource GeoWindow}"
                                          Width="10" Height="10" Stretch="Uniform"
                                          Stroke="{DynamicResource StatusSuccessBrush}"
                                          StrokeThickness="1.8"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FocusWindowButtonText}"
                                               Foreground="{DynamicResource StatusSuccessBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="FastPillBtn"
                                    Click="OnCloseClientClicked"
                                    Background="{DynamicResource StatusDangerBgBrush}"
                                    Foreground="{DynamicResource StatusDangerBrush}"
                                    BorderBrush="{DynamicResource StatusDangerBorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="6,4"
                                    ToolTip.Tip="{DynamicResource Card_TipCloseClient}">
                                <Path Data="{StaticResource GeoClose}"
                                      Width="9" Height="9" Stretch="Uniform"
                                      Stroke="{DynamicResource StatusDangerBrush}"
                                      StrokeThickness="2.2"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>

                        <Button Classes="FastPillBtn"
                                IsVisible="{Binding IsExpiredAndNotBanned}"
                                Click="OnLaunchOrReloginClicked"
                                Background="{DynamicResource StatusWarningBgBrush}"
                                Foreground="{DynamicResource StatusWarningBrush}"
                                BorderBrush="{DynamicResource StatusWarningBorderBrush}"
                                BorderThickness="1" FontWeight="Bold" FontSize="11"
                                CornerRadius="6" Padding="7,4"
                                ToolTip.Tip="{DynamicResource Card_TipReLogin}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Path Data="{StaticResource GeoKey}"
                                      Width="10" Height="10" Stretch="Uniform"
                                      Stroke="{DynamicResource StatusWarningBrush}"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Btn_ReLogin}"
                                           Foreground="{DynamicResource StatusWarningBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Classes="FastPillBtn"
                                IsVisible="{Binding IsBannedOrLocked}"
                                Click="OnViewBanClicked"
                                Background="{DynamicResource StatusDangerBgBrush}"
                                Foreground="#FDA4AF" BorderBrush="#7A1D35"
                                BorderThickness="1" FontWeight="Bold" FontSize="11"
                                CornerRadius="6" Padding="7,4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Path Data="{StaticResource GeoShieldAlert}"
                                      Width="10" Height="10" Stretch="Uniform"
                                      Stroke="#FDA4AF" StrokeThickness="2"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ViewBanButtonText}"
                                           Foreground="#FDA4AF"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Card Bottom Row -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <Panel Grid.Column="0" Width="42" Height="42"
                           Margin="0,0,10,0" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="21"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderHoverBrush}"
                                BorderThickness="1" ClipToBounds="True">
                            <Panel>
                                <TextBlock Text="{Binding Initials}"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Image Source="{Binding AvatarImage}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapInterpolationMode="MediumQuality" />
                            </Panel>
                        </Border>
                        <Border Width="42" Height="42" CornerRadius="21"
                                BorderBrush="{DynamicResource StatusSuccessBrush}"
                                BorderThickness="1.5"
                                IsVisible="{Binding IsInGame}"
                                IsHitTestVisible="False" />
                    </Panel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                Spacing="2" Margin="0,0,4,0" ClipToBounds="True">
                        <TextBlock Text="{Binding PrimaryTitle}"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="TabularNum"
                                   Text="{Binding SecondaryTitle}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis" />

                        <Border IsVisible="{Binding IsBannedOrLocked}"
                                Background="{DynamicResource StatusDangerBgBrush}"
                                BorderBrush="#7A1D35" BorderThickness="1"
                                CornerRadius="4" Padding="6,2"
                                Margin="0,2,0,0" HorizontalAlignment="Left"
                                MaxWidth="190">
                            <Grid ColumnDefinitions="Auto,*">
                                <Path Grid.Column="0"
                                      Data="{StaticResource GeoShieldAlert}"
                                      Width="10" Height="10" Stretch="Uniform"
                                      Stroke="#FDA4AF" StrokeThickness="2"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding BanNoticeText}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#FDA4AF"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Classes="TabularNum"
                                       Text="{Binding RobuxFormatted}"
                                       IsVisible="{Binding HasRobux}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource StatusWarningBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,1,5,1"
                                       ToolTip.Tip="{Binding RobuxTooltip}" />
                            <Border x:Name="MemoryPill"
                                    IsVisible="{Binding HasLiveMemory}"
                                    Background="{Binding MemoryPillBackground}"
                                    BorderBrush="{Binding MemoryPillBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusChip6}"
                                    Padding="4,1"
                                    Margin="0,1,0,1"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="5" Height="5"
                                             Fill="{Binding MemoryPillForeground}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Classes="TabularNum"
                                               Text="{Binding LiveMemoryText}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{Binding MemoryPillForeground}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                Spacing="2" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkSelect"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="0"
                                  Transitions="{x:Null}" />
                        <Button Classes="FastIconBtn" Width="24" Height="24"
                                Click="OnTogglePinClicked"
                                Opacity="{Binding PinOpacity}"
                                ToolTip.Tip="{DynamicResource Card_TipPin}">
                            <Path Data="{StaticResource GeoPin}"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding PinIconStroke}"
                                  StrokeThickness="1.7"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Button>
                        <Button x:Name="BtnInspect"
                                Classes="FastIconBtn" Width="24" Height="24"
                                Click="OnInspectClicked"
                                ToolTip.Tip="{DynamicResource Inspector_OpenTip}">
                            <Path Data="M 3,5 C 3,3.9 3.9,3 5,3 L 19,3 C 20.1,3 21,3.9 21,5 L 21,19 C 21,20.1 20.1,21 19,21 L 5,21 C 3.9,21 3,20.1 3,19 Z M 14,3 L 14,21"
                                  Width="12.5" Height="12.5" Stretch="Uniform"
                                  Stroke="{DynamicResource TextMutedBrush}"
                                  StrokeThickness="1.7"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Button>
                        <Button Classes="FastIconBtn" Width="24" Height="24"
                                Click="OnMoreClicked"
                                ToolTip.Tip="{DynamicResource Card_TipOptions}">
                            <Path Data="{StaticResource GeoEllipsis}"
                                  Width="14" Height="14" Stretch="Uniform"
                                  Fill="{DynamicResource TextMutedBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Panel>
    </Border>
</UserControl>
