<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:panels="clr-namespace:Shiro.AvaloniaUI.Views.Panels" xmlns:vm="clr-namespace:Shiro.ViewModels"
    xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia" mc:Ignorable="d" x:Class="Shiro.AvaloniaUI.Views.ServerListView" x:DataType="vm:ServerListViewModel"
    x:CompileBindings="True" x:Name="RootServerListView">
    <Grid RowDefinitions="Auto,Auto,*" Margin="20,16,20,16">
        <Border Grid.Row="0" Background="#111115" BorderBrush="#24242C" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="TxtPlaceId" Text="{Binding PlaceIdInput, Mode=TwoWay}" Width="155" Margin="0,2,8,2" Watermark="{DynamicResource Srv_PlaceIdPlaceholder}" Background="#18181F"
                        Foreground="#FFFFFF" BorderBrush="#2E2E38" CornerRadius="6" Padding="10,7" VerticalContentAlignment="Center">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding RefreshServersCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Border IsVisible="{Binding HasCurrentGameInfo}" Margin="0,2,8,2" Background="#141925" BorderBrush="#27344E" BorderThickness="1" CornerRadius="6" Padding="6,5" MaxWidth="180"
                        VerticalAlignment="Center" ToolTip.Tip="{Binding CurrentGameName}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" ClipToBounds="True" Background="#1C2333" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Panel>
                                    <lucide:Lucide Icon="Gamepad2" Width="11" Height="11" StrokeBrush="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="{Binding CurrentGameThumbnail, Converter={x:Static ObjectConverters.IsNull}}" />
                                    <Image Source="{Binding CurrentGameThumbnail}" Width="20" Height="20" Stretch="UniformToFill"
                        IsVisible="{Binding CurrentGameThumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </Panel>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentGameName}" FontSize="11" FontWeight="Normal" Foreground="#E4E4E7" VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <Button Command="{Binding RefreshServersCommand}" Margin="0,2,8,2" Background="#FFFFFF" Foreground="#09090B" FontWeight="Bold" CornerRadius="6" Padding="14,8" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6"><lucide:Lucide Icon="Search" Width="13" Height="13" StrokeBrush="#09090B" StrokeThickness="2.5"
                        VerticalAlignment="Center" /><TextBlock Text="{DynamicResource Srv_SearchServers}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Command="{Binding CancelOperationCommand}" IsVisible="{Binding CanCancelOperation}" Margin="0,2,8,2" Background="#2B1518" Foreground="#EF4444" BorderBrush="#4A1E24"
                        BorderThickness="1" CornerRadius="6" Padding="12,8" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6"><lucide:Lucide Icon="Square" Width="12" Height="12" StrokeBrush="#EF4444" VerticalAlignment="Center" /><TextBlock
                        Text="{DynamicResource Srv_Cancel}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Command="{Binding LoadAllRegionsCommand}" IsVisible="{Binding HasServers}" Margin="0,2,0,2" Background="#18181F" Foreground="#A1A1AA" BorderBrush="#2E2E38"
                        BorderThickness="1" CornerRadius="6" Padding="12,8" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6"><lucide:Lucide Icon="Globe" Width="13" Height="13" StrokeBrush="#A1A1AA" VerticalAlignment="Center" /><TextBlock
                        Text="{DynamicResource Srv_LoadAllRegions}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                    <TextBox Text="{Binding SearchPlayerUsername, Mode=TwoWay}" Width="165" Watermark="{DynamicResource Srv_SearchPlayerPlaceholder}" Background="#18181F" Foreground="#FFFFFF"
                        BorderBrush="#2E2E38" CornerRadius="6" Padding="10,7" VerticalContentAlignment="Center">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SearchPlayerCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Command="{Binding SearchPlayerCommand}" Background="#1E1E26" Foreground="#FFFFFF" BorderBrush="#2E2E38" BorderThickness="1" FontWeight="SemiBold" CornerRadius="6"
                        Padding="12,8" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6"><lucide:Lucide Icon="Search" Width="13" Height="13" StrokeBrush="#FFFFFF" VerticalAlignment="Center" /><TextBlock
                        Text="{DynamicResource Srv_Find}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#111115" BorderBrush="#24242C" BorderThickness="1" CornerRadius="8" Padding="6,6,14,6" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,Auto,*">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <RadioButton Classes="SubTabPill" GroupName="ServerSubTabs"
                        IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource EqualityToBoolean}, ConverterParameter='0', Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <lucide:Lucide Icon="Globe" Width="14" Height="14" StrokeBrush="#A1A1AA" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Srv_TabServers}" FontSize="12" VerticalAlignment="Center" />
                            <Border Background="#252532" CornerRadius="8" MinWidth="20" Padding="5,1" VerticalAlignment="Center" IsVisible="{Binding HasServers}"><TextBlock
                        Text="{Binding TotalServersCount}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="2,0" /></Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="SubTabPill" GroupName="ServerSubTabs"
                        IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource EqualityToBoolean}, ConverterParameter='1', Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8"><lucide:Lucide Icon="Gamepad2" Width="14" Height="14" StrokeBrush="#A1A1AA" VerticalAlignment="Center" /><TextBlock
                        Text="{DynamicResource Srv_TabExplorer}" FontSize="12" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Classes="SubTabPill" GroupName="ServerSubTabs"
                        IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource EqualityToBoolean}, ConverterParameter='2', Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8"><lucide:Lucide Icon="Star" Width="14" Height="14" StrokeBrush="#FBBF24" VerticalAlignment="Center" /><TextBlock
                        Text="{DynamicResource Srv_TabLibrary}" FontSize="12" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Classes="SubTabPill" GroupName="ServerSubTabs"
                        IsChecked="{Binding SelectedSubTabIndex, Converter={StaticResource EqualityToBoolean}, ConverterParameter='3', Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8"><lucide:Lucide Icon="Eye" Width="14" Height="14" StrokeBrush="#A1A1AA" VerticalAlignment="Center" /><TextBlock
                        Text="{DynamicResource Srv_TabWatcher}" FontSize="12" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" VerticalAlignment="Center"
                    IsVisible="{Binding SelectedSubTabIndex, Converter={StaticResource EqualityToBoolean}, ConverterParameter='0'}">
                    <ToggleButton Classes="ServerFilterPill" IsChecked="{Binding HideFullServers, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Srv_HideFullTip}">
                        <TextBlock Text="{DynamicResource Srv_HideFull}" />
                    </ToggleButton>
                    <ToggleButton Classes="ServerFilterPill" IsChecked="{Binding HideVipServers, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Srv_HideVipTip}">
                        <TextBlock Text="{DynamicResource Srv_HideVip}" />
                    </ToggleButton>
                </StackPanel>
                <Grid Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" ClipToBounds="True">
                    <TextBlock Text="{Binding LoadingStatus}" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Right"
                        HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="{Binding LoadingStatus}" />
                </Grid>
            </Grid>
        </Border>
        <Panel Grid.Row="2">
            <panels:ServerListResultsPanel />
            <Border Background="Transparent" Padding="12" IsHitTestVisible="True" IsVisible="{Binding SelectedSubTabIndex, Converter={StaticResource EqualityToBoolean}, ConverterParameter='2'}">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Margin="0,0,0,12">
                        <Button Command="{Binding AddFavoriteCommand}" Background="#18181F" Foreground="#F59E0B" BorderBrush="#2E2E38" BorderThickness="1" FontWeight="SemiBold" CornerRadius="6"
                        Padding="14,8" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6"><lucide:Lucide Icon="Star" Width="14" Height="14" StrokeBrush="#F59E0B" VerticalAlignment="Center" /><TextBlock
                        Text="{DynamicResource Srv_AddFavorite}" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                    </Border>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource Srv_RecentSectionTitle}" FontSize="11" FontWeight="Bold" Foreground="#93C5FD" LetterSpacing="0.5" Margin="6,0" />
                                <TextBlock Text="{DynamicResource Srv_RecentEmptyHint}" IsVisible="{Binding IsRecentGamesEmpty}" FontSize="12" Foreground="#71717A" Margin="6,4" />
                                <ItemsControl ItemsSource="{Binding RecentGames}" IsVisible="{Binding HasRecentGames}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RecentGameItemViewModel">
                                            <Border Width="330" Height="82" Background="#171923" BorderBrush="#242938" BorderThickness="1" CornerRadius="8" Margin="6" Padding="10">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" ClipToBounds="True" Background="#121218" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                                                        <Panel>
                                                            <lucide:Lucide Icon="Gamepad2" Width="22" Height="22" StrokeBrush="#52525B" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="{Binding ThumbnailBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                                                            <Image Source="{Binding ThumbnailBitmap}" Width="48" Height="48" Stretch="UniformToFill"
                        IsVisible="{Binding ThumbnailBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        </Panel>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" Margin="0,0,8,0"><TextBlock Text="{Binding Name}" FontWeight="Normal"
                        FontSize="13" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" /><TextBlock Text="{Binding PlaceId, StringFormat='ID: {0}'}"
                        FontSize="11" Foreground="#71717A" /></StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button Content="{DynamicResource Srv_Select}" Command="{Binding #RootServerListView.ViewModel.SelectRecentGameInLibraryCommand}"
                        CommandParameter="{Binding}" Background="#22222E" Foreground="#FFFFFF" CornerRadius="6" Padding="10,6" FontSize="11" Cursor="Hand"
                        ToolTip.Tip="{DynamicResource Srv_TipSelectPlace}" />
                                                        <Button Command="{Binding #RootServerListView.ViewModel.LaunchRecentGameInLibraryCommand}" CommandParameter="{Binding}"
                        Background="#22C55E" Foreground="#09090B" FontWeight="Bold" CornerRadius="6" Padding="10,6" FontSize="11" Cursor="Hand" ToolTip.Tip="{DynamicResource Srv_TipPlayGame}">
                                                            <StackPanel Orientation="Horizontal" Spacing="4"><lucide:Lucide Icon="Play" Width="10" Height="10" StrokeBrush="#09090B"
                        StrokeThickness="2.5" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource Srv_Play}" VerticalAlignment="Center" /></StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Separator Background="#22222C" Height="1" Margin="6,0" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource Srv_FavSectionTitle}" FontSize="11" FontWeight="Bold" Foreground="#FBBF24" LetterSpacing="0.5" Margin="6,0" />
                                <TextBlock Text="{DynamicResource Srv_FavEmptyHint}" IsVisible="{Binding IsFavoritesEmpty}" FontSize="12" Foreground="#71717A" Margin="6,4" />
                                <ItemsControl ItemsSource="{Binding Favorites}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FavoriteGameItemViewModel">
                                            <Border Width="360" Height="84" Background="#18181F" BorderBrush="#24242C" BorderThickness="1" CornerRadius="8" Margin="6" Padding="10">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" ClipToBounds="True" Background="#121218" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                                                        <Panel>
                                                            <lucide:Lucide Icon="Gamepad2" Width="22" Height="22" StrokeBrush="#52525B" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="{Binding ThumbnailBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                                                            <Image Source="{Binding ThumbnailBitmap}" Width="48" Height="48" Stretch="UniformToFill"
                        IsVisible="{Binding ThumbnailBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        </Panel>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" Margin="0,0,8,0"><TextBlock Text="{Binding Name}" FontWeight="Normal"
                        FontSize="13" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" /><TextBlock Text="{Binding PlaceId, StringFormat='ID: {0}'}"
                        FontSize="11" Foreground="#71717A" /></StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button Content="{DynamicResource Srv_Select}" Command="{Binding #RootServerListView.ViewModel.SelectFavoriteCommand}"
                        CommandParameter="{Binding}" Background="#22222E" Foreground="#FFFFFF" CornerRadius="6" Padding="10,6" FontSize="11" Cursor="Hand"
                        ToolTip.Tip="{DynamicResource Srv_TipSelectPlace}" />
                                                        <Button Command="{Binding #RootServerListView.ViewModel.LaunchFavoriteCommand}" CommandParameter="{Binding}" Background="#22C55E"
                        Foreground="#09090B" FontWeight="Bold" CornerRadius="6" Padding="10,6" FontSize="11" Cursor="Hand" ToolTip.Tip="{DynamicResource Srv_TipPlayGame}">
                                                            <StackPanel Orientation="Horizontal" Spacing="4"><lucide:Lucide Icon="Play" Width="10" Height="10" StrokeBrush="#09090B"
                        StrokeThickness="2.5" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource Srv_Play}" VerticalAlignment="Center" /></StackPanel>
                                                        </Button>
                                                        <Button Command="{Binding #RootServerListView.ViewModel.RemoveFavoriteCommand}" CommandParameter="{Binding}" Background="#2B1518"
                        CornerRadius="6" Padding="8,6" Cursor="Hand" ToolTip.Tip="{DynamicResource Srv_TipRemoveFav}"><lucide:Lucide Icon="Trash2" Width="12" Height="12" StrokeBrush="#EF4444"
                        /></Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <ScrollViewer Padding="12" IsVisible="{Binding SelectedSubTabIndex, Converter={StaticResource EqualityToBoolean}, ConverterParameter='3'}">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="16" Margin="10">
                        <Border Background="#14141A" BorderBrush="#24242C" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2"><TextBlock Text="{DynamicResource Srv_WatcherActivate}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"
                        /><TextBlock Text="{DynamicResource Srv_WatcherActivateDesc}" FontSize="11" Foreground="#A1A1AA" /></StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding WatcherEnabled, Mode=TwoWay}" />
                                </Grid>
                                <Separator Background="#24242C" Height="1" />
                                <CheckBox IsChecked="{Binding ExitOnBeta, Mode=TwoWay}" Content="{DynamicResource Srv_WatcherExitOnBeta}" Foreground="#FFFFFF" />
                                <CheckBox IsChecked="{Binding ExitIfNoConnection, Mode=TwoWay}" Content="{DynamicResource Srv_WatcherExitIfNoConn}" Foreground="#FFFFFF" />
                                <CheckBox IsChecked="{Binding SaveWindowPositions, Mode=TwoWay}" Content="{DynamicResource Srv_WatcherSaveWindowPositions}" Foreground="#FFFFFF" />
                                <CheckBox IsChecked="{Binding VerifyDataModel, Mode=TwoWay}" Content="{DynamicResource Srv_WatcherVerifyDataModel}" Foreground="#FFFFFF" />
                                <CheckBox IsChecked="{Binding IgnoreExistingProcesses, Mode=TwoWay}" Content="{DynamicResource Srv_WatcherIgnoreExisting}" Foreground="#FFFFFF" />
                                <CheckBox IsChecked="{Binding CloseRbxMemory, Mode=TwoWay}" Content="{DynamicResource Srv_WatcherCloseRbxMemory}" Foreground="#FFFFFF" />
                                <Separator Background="#24242C" Height="1" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2"><TextBlock Text="{DynamicResource Srv_WatcherMemoryThreshold}" Foreground="#FFFFFF" FontSize="13" /><TextBlock
                        Text="{DynamicResource Srv_WatcherMemoryThresholdDesc}" FontSize="11" Foreground="#A1A1AA" /></StackPanel>
                                    <NumericUpDown Grid.Column="1" Value="{Binding MemoryThresholdMb, Mode=TwoWay}" Minimum="100" Maximum="4096" Width="120" Background="#18181F"
                        Foreground="#FFFFFF" BorderBrush="#2E2E38" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
            </ScrollViewer>
        </Panel>
    </Grid>
</UserControl>
