<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        x:Class="Shiro.AvaloniaUI.Views.InputDialog"
        x:CompileBindings="True"
        Icon="/Resources/shiro.ico"
        Title="Shiro Prompt"
        Width="448" SizeToContent="Height"
        MinWidth="380" MaxWidth="600"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource SurfaceChromeBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TransparencyLevelHint="Mica, AcrylicBlur">

    <Border Background="{DynamicResource SurfacePanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusOuter16}"
            BoxShadow="{StaticResource ShadowModal}"
            Margin="10">
        <Panel>
            <Grid RowDefinitions="Auto,*,Auto" Margin="20">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center" Margin="0,0,0,14">
                    <Border Width="36" Height="36"
                            CornerRadius="{StaticResource RadiusInner8}"
                            Background="{DynamicResource StatusInfoBgBrush}"
                            BorderBrush="{DynamicResource StatusInfoBorderBrush}"
                            BorderThickness="1">
                        <lucide:Lucide Icon="Pencil" Width="16" Height="16"
                                       StrokeBrush="{DynamicResource StatusInfoBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TxtTitle" Text="{DynamicResource Loc_InputDialog_DefaultTitle}"
                               FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource BorderHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMid12}"
                        Padding="14"
                        Margin="0,0,0,16">
                    <StackPanel Spacing="12">
                        <SelectableTextBlock x:Name="TxtPrompt"
                                             Text="{DynamicResource Loc_InputDialog_DefaultPrompt}"
                                             FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                             TextWrapping="Wrap" LineHeight="19" />
                        <TextBox x:Name="TxtInput"
                                 CornerRadius="{StaticResource RadiusInner8}"
                                 Padding="10,8" FontSize="13"
                                 KeyDown="TxtInput_KeyDown" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="BtnCancel" Classes="StudioSecondaryBtn" Height="32" Padding="14,0"
                            CornerRadius="{StaticResource RadiusChip6}"
                            Click="BtnCancel_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <lucide:Lucide Icon="X" Width="13" Height="13"
                                           StrokeBrush="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Loc_Dialog_CancelShort}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnOK" Classes="StudioPrimaryBtn" Height="32" Padding="14,0"
                            CornerRadius="{StaticResource RadiusChip6}"
                            Click="BtnOK_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <lucide:Lucide Icon="Check" Width="13" Height="13"
                                           StrokeBrush="{DynamicResource AccentForegroundBrush}"
                                           StrokeThickness="2.4" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Loc_Btn_OK}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Border IsHitTestVisible="False"
                    BorderBrush="{DynamicResource BorderTopRimBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusOuter16}" />
        </Panel>
    </Border>
</Window>
