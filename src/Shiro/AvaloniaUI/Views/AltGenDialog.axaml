<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lucide="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        xmlns:vm="clr-namespace:Shiro.ViewModels.Dialogs"
        x:Class="Shiro.AvaloniaUI.Views.AltGenDialog"
        x:DataType="vm:AltGenViewModel"
        Icon="/Resources/shiro.ico"
        Title="{DynamicResource Loc_AltGen_WindowTitle}"
        Width="540" SizeToContent="Height"
        MinWidth="480" MaxWidth="600"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#0D0D11"
        Foreground="#F4F4F5">

    <Border BorderBrush="#272730" BorderThickness="1" CornerRadius="8" Padding="20">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#252536" CornerRadius="8" Width="36" Height="36">
                        <lucide:Lucide Icon="UserPlus" Width="18" Height="18" StrokeBrush="#818CF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc_AltGen_HeaderTitle}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="{DynamicResource Loc_AltGen_HeaderSubtitle}" FontSize="11" Foreground="#71717A"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Configuration Card -->
            <Border Grid.Row="1" Background="#14141C" BorderBrush="#272733" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel Spacing="12">
                    <!-- API Key Input -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Loc_AltGen_ApiKeyLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#D4D4D8"/>
                        <TextBox x:Name="TxtApiKey" Text="{Binding ApiKey, Mode=TwoWay}" PasswordChar="•" Watermark="{DynamicResource Loc_AltGen_ApiKeyWatermark}"
                                 Background="#1F1F28" Foreground="#FFFFFF" BorderBrush="#2E2E38" BorderThickness="1"
                                 CornerRadius="4" Padding="10,7" FontSize="12" />
                    </StackPanel>

                    <!-- Options Grid: GenType & Continent -->
                    <Grid ColumnDefinitions="*,*">
                        <!-- Gen Type -->
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Loc_AltGen_GenTypeLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#D4D4D8"/>
                            <ComboBox x:Name="CmbGenType" HorizontalAlignment="Stretch"
                                      SelectedValue="{Binding SelectedGenType, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding Tag, DataType=ComboBoxItem}"
                                      Background="#1F1F28" Foreground="#FFFFFF" BorderBrush="#2E2E38" CornerRadius="4">
                                <ComboBoxItem Content="{DynamicResource Loc_AltGen_TypeUnverified}" Tag="unverified"/>
                                <ComboBoxItem Content="{DynamicResource Loc_AltGen_Type30Days}" Tag="+30 days old"/>
                                <ComboBoxItem Content="{DynamicResource Loc_AltGen_Type1Year}" Tag="+1 year old"/>
                                <ComboBoxItem Content="{DynamicResource Loc_AltGen_Type5Years}" Tag="5+ years old"/>
                                <ComboBoxItem Content="{DynamicResource Loc_AltGen_TypeAgeVerified}" Tag="18+ age verified"/>
                                <ComboBoxItem Content="{DynamicResource Loc_AltGen_TypeDump}" Tag="dump"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Continent -->
                        <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource Loc_AltGen_ContinentLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#D4D4D8"/>
                            <ComboBox x:Name="CmbContinent" HorizontalAlignment="Stretch"
                                      SelectedValue="{Binding SelectedContinent, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding Tag, DataType=ComboBoxItem}"
                                      Background="#1F1F28" Foreground="#FFFFFF" BorderBrush="#2E2E38" CornerRadius="4">
                                <ComboBoxItem Content="{DynamicResource Loc_AltGen_ContinentRandom}" Tag="RANDOM"/>
                                <ComboBoxItem Content="{DynamicResource Loc_AltGen_ContinentAS}" Tag="AS"/>
                                <ComboBoxItem Content="{DynamicResource Loc_AltGen_ContinentNA}" Tag="NA"/>
                                <ComboBoxItem Content="{DynamicResource Loc_AltGen_ContinentEU}" Tag="EU"/>
                                <ComboBoxItem Content="{DynamicResource Loc_AltGen_ContinentOC}" Tag="OC"/>
                                <ComboBoxItem Content="{DynamicResource Loc_AltGen_ContinentSA}" Tag="SA"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Target Group -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Loc_AltGen_TargetGroupLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#D4D4D8"/>
                        <TextBox x:Name="TxtGroup" Text="{Binding GroupName, Mode=TwoWay}"
                                 Background="#1F1F28" Foreground="#FFFFFF" BorderBrush="#2E2E38" BorderThickness="1"
                                 CornerRadius="4" Padding="10,7" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Result Box (Hidden until generated) -->
            <Border Grid.Row="2" x:Name="BrdResult" IsVisible="{Binding HasResult}" Background="#161B26" BorderBrush="#2E3A59" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:Lucide Icon="CircleCheck" Width="14" Height="14" StrokeBrush="#34D399" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc_AltGen_ResultSavedHeading}" FontSize="12" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Username: " Foreground="#9CA3AF" FontSize="11"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtResultUser" Text="{Binding ResultUsername}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="11"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="User ID: " Foreground="#9CA3AF" FontSize="11"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtResultId" Text="{Binding ResultUserId}" Foreground="#FFFFFF" FontSize="11"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Password: " Foreground="#9CA3AF" FontSize="11"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtResultPass" Text="{Binding ResultPassword}" Foreground="#FBBF24" FontSize="11"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Status text -->
            <TextBlock Grid.Row="3" x:Name="TxtStatus" Text="{Binding StatusText}"
                       Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}"
                       FontSize="11" Margin="0,0,0,12"/>

            <!-- Action buttons -->
            <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" x:Name="BtnOpenHistory" Command="{Binding OpenHistoryCommand}"
                        Background="#1E1E2A" Foreground="#A1A1AA" CornerRadius="6" Padding="14,8" FontSize="12" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:Lucide Icon="FileText" Width="13" Height="13" StrokeBrush="#A1A1AA" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc_AltGen_OpenHistoryBtn}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnClose" Command="{Binding CloseCommand}"
                            Background="Transparent" Foreground="#A1A1AA" CornerRadius="6" Padding="14,8" FontSize="12" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:Lucide Icon="X" Width="13" Height="13" StrokeBrush="#A1A1AA" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Loc_Btn_Close}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnGenerate" Command="{Binding GenerateCommand}" IsEnabled="{Binding !IsBusy}"
                            Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="6" Padding="18,8" FontSize="12" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:Lucide Icon="Sparkles" Width="13" Height="13" StrokeBrush="#FFFFFF" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Loc_AltGen_GenerateNowBtn}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
